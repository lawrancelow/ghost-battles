	J.G["PRES_TXT"] = {"issue": [["旁白", "阿福收到一封信，信封寫住「機密・限本人拆閱」。拆開之前，龐總已經飄咗喺佢後面。", "阿福收到一封信，信封寫著「機密・限本人拆閱」。拆開之前，龐總已經飄在他身後。"], ["龐總", "阿福，坐。唔使驚，今日唔係裁員，係簽約。", "阿福，坐。不用怕，今天不是裁員，是簽約。", "ag:inspect"], ["阿福", "我死咗喎。仲有約簽？", "我都死了。還有約要簽？"], ["龐總", "正正因為你死咗。陰間有條規矩：冇人記得嘅鬼，會慢慢淡走。淡到冇，就真係冇。", "正因為你死了。陰間有條規矩：沒人記得的鬼，會慢慢淡掉。淡到沒有，就真的沒了。"], ["冼小姐", "親愛嘅阿福～我哋叫佢「淡化處理」。聽落溫柔啲。", "親愛的阿福～我們稱它為「淡化處理」。聽起來溫柔一點。", "ag:clip"], ["阿福", "……即係同我生前份工一樣。冇人記得我做過咩，最後連個位都冇埋。", "……就跟我生前那份工作一樣。沒人記得我做過什麼，最後連座位都沒了。"], ["龐總", "分別係：今次有合約。七日之內，回陽間嚇人，儲夠 KPI。人驚你，人講你，你就存在。", "差別是：這次有合約。七天之內，回陽間嚇人，攢夠 KPI。有人怕你，有人講你，你就存在。", "ag:tap"], ["冼小姐", "試用期職稱：打工鬼。過關轉正，唔過……（蓋印）淡化。", "試用期職稱：打工鬼。過關轉正，不過的話……（蓋章）淡化。", "ag:stamp"], ["阿福", "凌晨兩點十三分，我覆咗最後一個「好」。之後冇人再搵過我。", "凌晨兩點十三分，我回了最後一個「好」。之後再也沒人找過我。"], ["阿福", "……好。今次我簽，但係我要寫清楚：死後唔包 OT。", "……好。這次我簽，但我要寫清楚：死後不包加班。"], ["龐總", "加咗喇。（劃走）唔該簽呢度。", "加上了。（劃掉）請在這裡簽名。"], ["系統", "【試用期合約】七日內 KPI 達標即可轉正。回陽間嚇人、傳說熱度都計分。村裡每隻鬼都有「存在感」，回陽間會令全村被記起。", "【試用期合約】七天內 KPI 達標即可轉正。回陽間嚇人、傳說熱度都計分。村裡每隻鬼都有「存在感」，回陽間會讓全村被記起。"]], "taunt": [[["Bryan", "兄弟，合約仲剩幾日？我上個月已經轉正。你知點解？我識做 report。", "兄弟，合約還剩幾天？我上個月就轉正了。你知道為什麼嗎？我會寫 report。", "ag:dribble"], ["阿福", "你嚇過幾多人？", "你嚇過幾個人？"], ["Bryan", "一個都冇。但係我張 report 有圖表。", "一個都沒有。但我的 report 有圖表。", "ag:jumpshot"]], [["Bryan", "阿福，你個樣淡咗少少喎。係咪冇瞓好？定係冇人記得你？", "阿福，你看起來淡了一點喔。是沒睡好？還是沒人記得你？", "ag:gossip"], ["阿福", "……兩樣都係。", "……兩樣都是。"], ["Bryan", "唔緊要，我會記得你。我會同人講：「嗰個阿福，我以前帶過佢。」", "沒關係，我會記得你。我會跟人說：「那個阿福，我以前帶過他。」"]], [["Bryan", "兄弟，KPI 未夠呀？我教你：唔好嚇人，嚇數字。", "兄弟，KPI 還不夠啊？我教你：不要嚇人，嚇數字。", "ag:spin"], ["阿福", "點嚇數字？", "數字要怎麼嚇？"], ["Bryan", "將「三」寫做「八」。佢自己會驚。", "把「三」寫成「八」。它自己會怕。"], ["阿福", "……我寧願去嚇真人。", "……我寧願去嚇真人。"]]], "promote": [null, [["龐總", "阿福，KPI 達標。由今日起，你係正式鬼。", "阿福，KPI 達標。從今天起，你是正式鬼。", "ag:inspect"], ["冼小姐", "恭喜～轉正福利：回陽間可以多帶一隻鬼，同埋一張正式員工證。", "恭喜～轉正福利：回陽間可以多帶一隻鬼，還有一張正式員工證。", "ag:stamp"], ["阿福", "張證點解冇我個樣？", "證件上為什麼沒有我的樣子？"], ["冼小姐", "鬼影唔到相。所以我哋畫咗個圈，寫住「此處有人」。", "鬼拍不了照。所以我們畫了一個圈，寫著「此處有人」。"], ["阿福", "……生前張員工證都差唔多。", "……生前那張員工證也差不多。"]], [["龐總", "你升組長。組長嘅意思係：你嘅 KPI，係你隊鬼嘅 KPI 加埋。", "你升組長了。組長的意思是：你的 KPI，是你整