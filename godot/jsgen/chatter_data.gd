	J.G["CHAT_DATA"] = {"named": {"afu": [["死咗最大嘅好處：唔使再覆「收到」。", "死了最大的好處：不用再回「收到」。"], ["我生前最驚星期一。而家冇星期一，得頭七。", "我生前最怕星期一。現在沒有星期一，只有頭七。"], ["原來加班會死，公司 training 冇教過。", "原來加班會死，公司 training 沒教過。"], ["健身室仲扣緊我錢。違約金，可以分期。", "健身房還在扣我的錢。違約金，可以分期。"], ["躺平呢樣嘢，我比你哋早，又比你哋平。", "躺平這件事，我比你們早，也比你們平。"], ["做村長同做 manager 一樣：出事搵我，搞掂就係大家功勞。", "當村長跟當 manager 一樣：出事找我，搞定是大家的功勞。"], ["我死嗰日，個 report 仲未 save。", "我死那天，那份 report 還沒 save。"], ["陰間最大嘅福利：冇人叫我「Fu 哥，幫幫手」。", "陰間最大的福利：沒人叫我「Fu 哥，幫個忙」。"], ["我而家知點解老闆成日話「當自己屋企」——原來係叫你瞓喺度。", "我現在懂為什麼老闆總說「當自己家」——原來是叫你睡在這裡。"], ["三點。我條件反射打開咗 email。", "三點。我條件反射打開了 email。", "夜"], ["夜晚咁靜，我反而唔慣。冇 notification 聲，好似少咗啲咩。", "晚上這麼安靜，我反而不習慣。沒有通知聲，好像少了什麼。", "夜"], ["朝早唔使搭 LRT，係我死咗之後最開心嘅事。", "早上不用擠 LRT，是我死後最開心的事。", "晨"], ["打贏咗。如果生前打工都可以打贏老闆就好。", "打贏了。如果生前上班也能打贏老闆就好了。", "win"], ["輸咗唔緊要，我生前每個 appraisal 都係咁過。", "輸了沒關係，我生前每次考核都是這樣過的。", "lose"], ["{N}入村，我要搵間屋畀佢……先睇吓有冇棺材板。", "{N}進村了，我要找間屋給他……先看有沒有棺材板。", "new"], ["龐總嚟完，我隻眼皮跳咗成個鐘。生前留低嘅後遺症。", "龐總來過以後，我眼皮跳了一個鐘頭。生前留下的後遺症。", "boss"], ["Bryan 又話佢功勞大。我諗起我上一份工個 team lead。", "Bryan 又說他功勞大。我想起上一份工的 team lead。", "rival"], ["冼小姐話我「態度有待改善」。我死咗喎，仲要改？", "冼小姐說我「態度有待改善」。我都死了，還要改？", "hr"], ["我開咗個 Excel 計村入面嘅數。", "我開了個 Excel 算村裡的帳。", "arc:afu:1"], ["個 Excel 有十二個 tab。我開始覺得唔對路。", "那個 Excel 有十二個 tab。我開始覺得不對勁。", "arc:afu:2"], ["我頭先幫個 Excel 加咗個 pivot table。我又變返打工仔。", "我剛才幫 Excel 加了個 pivot table。我又變回打工仔了。", "arc:afu:3"], ["以前做到死，而家做到有個村。都係做，但係感覺唔同。", "以前做到死，現在做出了一個村。都是做，但感覺不一樣。", "late"]], "xiaozhi": [["少爺，今日風大，我畀風吹走咗兩次。", "少爺，今天風大，我被風吹走了兩次。"], ["我係紙做嘅，唔怕畀人炒，最怕畀人燒。", "我是紙做的，不怕被炒，只怕被燒。"], ["我唔可以喊，一喊就會溶。", "我不能哭，一哭就會糊掉。"], ["夫人燒我落嚟，唔記得燒埋我份人工。", "夫人燒我下來的時候，忘了燒我的薪水。"], ["少爺，你件衫我熨好咗。我用自己個身熨嘅，我好平。", "少爺，你的衣服我燙好了。用我自己燙的，我很平。"], ["我嘅保養方法：避免日曬、避免雨淋、避免靠近化寶爐。", "我的保養方法：避免日曬、避免雨淋、避免靠近化寶爐。"], ["少爺，我幫你個房執好咗。啲 report 分咗類：未做、做緊、扮冇睇過。", "少爺，你的房間我整理好了。report 分了類：沒做、做緊、假裝沒看過。"], ["我手巧，但係最好唔好叫我切洋蔥。", "我手很巧，但最好不要叫我切洋蔥。"], ["我個樣係夫人揀嘅。佢揀咗「乖巧型」，我其實想要「霸氣型」。", "我的樣子是夫人選的。她選了「乖巧型」，其實我想要「霸氣型」。"], ["少爺，夜喇，你瞓先。我唔使瞓，我係紙。", "少爺，很晚了，你先睡。我不用睡，我是紙。", "夜"], ["夜晚啲露水好重，我要攝喺天花姐隔籬吹乾。", "晚上露水很重，我要躲在天花姐旁邊吹乾。", "夜"], ["包包要摺十八個褶，我摺二十個，多兩個係心意。", "包子要摺十八個褶，我摺二十個，多兩個是心意。", "p:bun"], ["倉庫數我點過三次，Toyol 話佢點過四次。數字唔同，我信我自己。", "倉庫的數我點了三次，Toyol 說他點了四次。數字不一樣，我信我自己。", "p:store"], ["少爺好叻！我即刻摺隻紙鶴慶祝。", "少爺好厲害！我馬上摺一隻紙鶴慶祝。", "win"], ["少爺唔好唔開心。我幫你摺返隻……摺返個笑容。", "少爺不要不開心。我幫你摺一個……摺一個笑臉。", "lose"], ["{N}嚟咗！我要整多套被鋪，唔知佢鍾意紙定布。", "{N}來了！我要多做一套被鋪，不知道他喜歡紙的還是布的。", "new"], ["冼小姐問我有冇保險。我話有，保單係夫人燒落嚟嘅。", "冼小姐問我有沒有保險。我說有，保單是夫人燒下來的。", "hr"], ["少爺，我想報個興趣班：游水。", "少爺，我想報個興趣班：游泳。", "arc:xiaozhi:1"], ["游水班教練話，我第一堂已經「融入咗個池」。", "游泳教練說，我第一堂課就已經「融入了泳池」。", "arc:xiaozhi:2"], ["我轉咗報摺紙班。導師叫我示範，因為我本身就係功課。", "我改報了摺紙班。老師叫我示範，因為我本身就是作業。", "arc:xiaozhi:3"], ["Bryan 叫我幫佢沖杯咖啡。我沖咗，用凍水。", "Bryan 叫我幫他泡咖啡。我泡了，用冷水。", "rival"]], "eguiking": [["我條喉嚨細到連八卦都吞唔落。", "我的喉嚨細得連八卦都吞不下去。"], ["醫生叫我少食多餐。我做到喇：一路少食，一路多餐。", "醫生叫我少吃多餐。我做到了：一直少吃，一直多餐。"], ["五百年嚟我只學識一樣嘢：食 buffet 要第一個到。", "五百年來我只學會一件事：吃 buffet 要第一個到。"], ["唔好睇我個肚咁大，入面全部係空氣。五百年嘅空氣。", "別看我肚子大，裡面全是空氣。五百年的空氣。"], ["我食一粒米要兩個鐘。唔係我慢，係粒米大。", "我吃一粒米要兩個鐘頭。不是我慢，是米太大。"], ["我唔係貪食，我係補返五百年嘅飯。", "我不是貪吃，我是在補五百年的飯。"], ["我最憎人講「隨便食啲」。隨便係邊度？有冇得食？", "我最討厭人說「隨便吃點」。隨便在哪裡？有得吃嗎？"], ["人哋講「民以食為天」。我個天，五百年冇開過。", "人家說「民以食為天」。我的天，五百年沒開過。"], ["我聞得出邊間屋今晚煮咩。三號屋：煎魚，煎燶咗。", "我聞得出哪間屋今晚煮什麼。三號屋：煎魚，煎焦了。"], ["夜晚肚餓特別大聲，我個肚叫，成條村都醒。", "晚上肚子餓特別大聲，我肚子一叫，全村都醒了。", "夜"], ["斬柴好，斬完有柴，有柴就有火，有火就有得煮。我諗得好遠。", "砍柴好，砍完有柴，有柴就有火，有火就能煮。我想得很遠。", "p:wood"], ["包子鋪派我去？……你肯定？", "派我去包子鋪？……你確定？", "p:bun"], ["打贏咗！慶功宴幾點？我帶埋碗。", "打贏了！慶功宴幾點？我帶碗來。", "win"], ["輸咗冇所謂，最緊要今晚有冇宵夜。", "輸了無所謂，最重要是今晚有沒有宵夜。", "lose"], ["{N}入村？佢食唔食包？唔食最好，我幫佢食。", "{N}進村了？他吃不吃包子？不吃最好，我幫他吃。", "new"], ["龐總話要「瘦身」。我已經瘦咗五百年。", "龐總說公司要「瘦身」。我已經瘦了五百年。", "boss"], ["我決定減肥。", "我決定減肥。", "arc:egk:1"], ["減肥第二日：我減咗一粒米。即係我成日嘅糧。", "減肥第二天：我減了一粒米。也就是我一整天的糧食。", "arc:egk:2"], ["減肥失敗。原因：冇嘢可以再減。", "減肥失敗。原因：沒東西可以再減了。", "arc:egk:3"], ["冼小姐話員工餐要申請。我五百年前已經申請咗，未批。", "冼小姐說員工餐要申請。我五百年前就申請了，還沒批。", "hr"]], "toyol": [["呢張冥幣印住邊個？面額咁大，個人咁醜。", "這張冥幣上印的是誰？面額這麼大，人這麼醜。"], ["我冇偷，我係借。借咗三年啫。", "我沒有偷，我只是借。借了三年而已。"], ["老闆話可以摸冥幣，冇講唔可以舔。", "老闆說可以摸冥幣，沒說不能舔。"], ["主人搬屋冇帶我走，帶咗盆發財樹。", "主人搬家沒帶我，倒是帶走了那盆發財樹。"], ["倉庫失竊率係零，因為我就係倉庫。", "倉庫失竊率是零，因為我就是倉庫。"], ["我細細隻，所以啲錢我都摺細啲先袋。", "我小小一隻，所以錢我都摺小一點才放進口袋。"], ["我唔識數，但係我識數錢。兩樣嘢唔同㗎。", "我不會算數，但我會數錢。兩件事不一樣的。"], ["我最鍾意嘅聲音：銅錢跌落地。第二鍾意：銅錢跌落我手。", "我最喜歡的聲音：銅錢掉在地上。第二喜歡：銅錢掉到我手上。"], ["有人話養小鬼會發達。我哋小鬼自己都未發過。", "有人說養小鬼會發財。我們小鬼自己都還沒發過。"], ["夜晚係我嘅上班時間。習慣咗，改唔到。", "晚上是我的上班時間。習慣了，改不掉。", "夜"], ["今日倉庫多咗三個銅錢。唔使問邊度嚟，係我「撿」嘅。", "今天倉庫多了三個銅錢。不用問哪來的，是我「撿」的。", "p:store"], ["打完仗有戰利品！……我意思係，幫你點算戰利品。", "打完仗有戰利品！……我的意思是，幫你點算戰利品。", "win"], ["輸咗？咁啲錢……我收埋先，安全啲。", "輸了？那錢……我先收起來，比較安全。", "lose"], ["{N}嚟咗？佢有冇帶錢包？我淨係問吓。", "{N}來了？他有沒有帶錢包？我只是問問。", "new"], ["Bryan 個銀包好厚。……我冇掂過，我淨係望過。", "Bryan 的錢包很厚。……我沒碰過，我只是看過。", "rival"], ["我開始學投資。", "我開始學投資了。", "arc:toyol:1"], ["投資第一課：錢要分散。我將啲錢收喺十個唔同地方。", "投資第一課：錢要分散。我把錢藏在十個不同地方。", "arc:toyol:2"], ["我唔記得收咗喺邊十個地方。投資失敗。", "我忘了藏在哪十個地方。投資失敗。", "arc:toyol:3"], ["龐總問我倉庫點解數唔夾。我答：因為我未夾。", "龐總問我倉庫的帳為什麼對不上。我說：因為我還沒對。", "boss"], ["冼小姐要我填利益衝突申報。我寫：全部都係利益。", "冼小姐要我填利益衝突申報表。我寫：全部都是利益。", "hr"], ["以前我偷人哋錢，而家我守住全村錢。我媽知道會好驕傲——如果我有媽。", "以前我偷別人的錢，現在我守著全村的錢。我媽知道會很驕傲——如果我有媽的話。", "mid"]], "laojiang": [["本官膝頭唔可以屈，所以從來唔跪，包括對老闆。", "本官膝蓋不能彎，所以從不下跪，包括對老闆。"], ["本官嘅退休金，係用銅錢計嘅。", "本官的退休金，是用銅錢算的。"], ["兩百年冇瞓過一覺好。棺材太硬，枕頭係磚。", "兩百年沒睡過好覺。棺材太硬，枕頭是磚。"], ["邊個喺本官額頭貼咗張「已讀」？哦，係符。", "誰在本官額頭貼了一張「已讀」？哦，是符。"], ["本官七品。七品即係……大概你哋嘅 senior executive。", "本官七品。七品就是……大概你們的 senior executive。"], ["本官跳咗兩百年，膝頭已經冇保養期。", "本官跳了兩百年，膝蓋已經過了保固期。"], ["後生仔，行路要兩隻腳一齊，咁先有官威。", "年輕人，走路要兩隻腳一起，這樣才有官威。"], ["本官唔食糯米。唔係唔鍾意，係有醫生紙。", "本官不吃糯米。不是不喜歡，是有醫生證明。"], ["本官最憎樓梯。發明樓梯嗰個，一定冇做過殭屍。", "本官最恨樓梯。發明樓梯的人，一定沒當過殭屍。"], ["月光咁好，本官想跳出去散步。跳步。", "月光這麼好，本官想跳出去散步。跳步。", "夜"], ["天光喇，本官要返棺材。唔係瞓覺，係避日。", "天亮了，本官要回棺材。不是睡覺，是避太陽。", "晨"], ["棺材板要揀厚，本官瞓過，本官知。", "棺材板要選厚的，本官睡過，本官知道。", "p:plank"], ["……本官點解會喺糯米田？邊個排嘅班？", "……本官怎麼會在糯米田？誰排的班？", "p:rice"], ["凱旋！本官要寫奏摺。……寫畀邊個呢？", "凱旋！本官要寫奏摺。……寫給誰呢？", "win"], ["兵家勝敗乃常事。本官兩百年前都輸過，輸畀道士。", "勝敗乃兵家常事。本官兩百年前也輸過，輸給道士。", "lose"], ["{N}入村？叫佢嚟拜見本官。唔使跪，本官都跪唔到。", "{N}進村了？叫他來拜見本官。不用跪，本官也跪不了。", "new"], ["龐總話要「扁平化管理」。本官塊面已經夠扁。", "龐總說要「扁平化管理」。本官的臉已經夠扁了。", "boss"], ["本官決定學瑜伽。", "本官決定學瑜伽。", "arc:lj:1"], ["瑜伽導師叫本官彎腰。本官彎咗——成個人跌低。", "瑜伽老師叫本官彎腰。本官彎了——整個人倒下去。", "arc:lj:2"], ["導師改教本官「平板支撐」。本官做咗三日，未起身，冠軍。", "老師改教本官「平板支撐」。本官撐了三天還沒起來，冠軍。", "arc:lj:3"], ["冼小姐話本官嘅官位「唔獲承認」。大清都冇咗，本官點會唔知。", "冼小姐說本官的官位「不獲承認」。大清都沒了，本官怎會不知道。", "hr"]], "pontianak": [["我淨係笑咗一聲，係你哋自己嚇死嘅。", "我只是笑了一聲，是你們自己嚇死的。"], ["香蕉樹嘅租，平過吉隆坡啲 condo 好多。", "香蕉樹的租金，比吉隆坡的公寓便宜多了。"], ["後頸呢口釘，係我身上最貴嘅首飾。", "後頸這根釘子，是我身上最貴的首飾。"], ["男人話「聽日再嚟」，我就知道冇聽日。", "男人說「明天再來」，我就知道沒有明天了。"], ["我啲頭髮唔使 rebonding，天生直，因為死得直。", "我的頭髮不用離子燙，天生直，因為死得很直。"], ["我嗰陣笑聲，越遠越大聲。所以你聽到好細聲……就快啲走。", "我的笑聲越遠越大聲。所以你聽到很小聲的時候……就快點走。"], ["sayang，你唔好咁望住我，我會唔好意思。", "sayang，你不要這樣看著我，我會不好意思。"], ["我條白裙係舊款，但係經典。", "我這條白裙是舊款，但很經典。"], ["有人送花畀我，係雞蛋花。好香，但係我想要現金。", "有人送花給我，是雞蛋花。很香，但我比較想要現金。"], ["夜喇，香蕉園係我嘅舞台。", "晚上了，香蕉園是我的舞台。", "夜"], ["天光喇。我唔做夜班之後，終於知道朝早個天係咩色。", "天亮了。我不上夜班之後，終於知道早上的天是什麼顏色。", "晨"], ["贏咗？我笑一聲慶祝——你哋掩住耳先。", "贏了？我笑一聲慶祝——你們先摀住耳朵。", "win"], ["輸咗嘅男人，我見得多。你算係好睇嗰個。", "輸了的男人，我見多了。你算好看的那個。", "lose"], ["{N}入村？香蕉樹仲有位，叫佢唔好坐我嗰棵。", "{N}進村了？香蕉樹還有位，叫他不要坐我那棵。", "new"], ["Bryan 問我電話號碼。我畀咗佢——香蕉園嘅地址。", "Bryan 問我電話號碼。我給了他——香蕉園的地址。", "rival"], ["我報咗唱歌班。", "我報了唱歌班。", "arc:ponti:1"], ["老師叫我高音。我一高，隔籬村啲狗全部吠。", "老師叫我唱高音。我一唱，隔壁村的狗全部在吠。", "arc:ponti:2"], ["老師退咗我學費，叫我去報合唱團——做背景音效。", "老師退了我學費，叫我去參加合唱團——當背景音效。", "arc:ponti:3"], ["冼小姐話我唔做夜班要寫原因。我寫：「冇男人值得等」。", "冼小姐說我不上夜班要寫原因。我寫：「沒有男人值得等」。", "hr"], ["龐總行過香蕉園，好快。比佢做 report 快好多。", "龐總走過香蕉園，走得很快。比他做 report 快多了。", "boss"]], "pocong": [["計步器話我今日零步。我明明跳咗兩萬下。", "計步器說我今天零步。我明明跳了兩萬下。"], ["雙手終於自由，可惜冇人同我 give me five。", "手終於自由了，可惜沒人跟我擊掌。"], ["我著白色唔係為咗潮，係冇得揀。", "我穿白色不是為了時尚，是沒得選。"], ["跳舞？我只識一隻舞：一路跳。", "跳舞？我只會一種舞：一直跳。"], ["我上落樓梯要跳二十四下，所以我住樓下。", "我上下樓梯要跳二十四下，所以我住樓下。"], ["我舉得手啦！……但係我唔知要舉嚟做乜。", "我能舉手了！……但我不知道要舉來幹嘛。"], ["人哋問我做咩運動。我答：生存。", "別人問我做什麼運動。我答：生存。"], ["我條綁帶解咗，但係我隻腳仲記得被綁住。肌肉記憶。", "我的綁帶解開了，但腳還記得被綁著。肌肉記憶。"], ["我最驚落斜路。一跳，就停唔到。", "我最怕下坡。一跳，就停不下來。"], ["夜晚跳出去散步，啲狗以為我係大白兔。", "晚上跳出去散步，狗以為我是大白兔。", "夜"], ["斬柴嗰陣我要跳過去、斬一下、跳返嚟。效率……有待改善。", "砍柴時我要跳過去、砍一下、跳回來。效率……有待改善。", "p:wood"], ["打贏！我舉手歡呼！……第一次可以咁做。", "打贏了！我舉手歡呼！……第一次能這樣做。", "win"], ["輸咗，我跳返屋企。估計要跳一個鐘。", "輸了，我跳回家。估計要跳一個鐘頭。", "lose"], ["{N}嚟咗？我同佢 give me five！……佢縮手。", "{N}來了？我跟他擊掌！……他縮手了。", "new"], ["Bryan 叫我同佢打波。我話我唔使學，我天生就識跳。", "Bryan 叫我跟他打球。我說不用學，我天生會跳。", "rival"], ["我報咗跳繩比賽。", "我報名了跳繩比賽。", "arc:pocong:1"], ["評判話我冇用繩，唔計分。", "評審說我沒用繩子，不算分。", "arc:pocong:2"], ["我用咗繩。評判話我用錯：唔係綁住自己。", "我用了繩子。評審說我用錯了：不是綁在自己身上。", "arc:pocong:3"], ["冼小姐叫我填「出勤記錄」。我寫：跳勤。", "冼小姐叫我填「出勤記錄」。我寫：跳勤。", "hr"], ["我而家可以一跳就跳上屋頂。仲未學識點落嚟。", "我現在一跳就能跳上屋頂。還沒學會怎麼下來。", "mid"]], "penanggal": [["今日啲醋好似過咗期，個身塞唔返入去。", "今天的醋好像過期了，身體塞不回去。"], ["返工唔使搭車，個頭飛過去就得。", "上班不用通勤，頭飛過去就好。"], ["唔好問我腰圍，我冇腰。", "別問我腰圍，我沒有腰。"], ["我得個頭，所以老闆話我「好有頭腦」。", "我只有頭，所以老闆說我「很有頭腦」。"], ["我個身留咗喺屋企，佢比我更準時。", "我的身體留在家裡，它比我還準時。"], ["我做過接生婆，接過好多 BB。而家我淨係接訂單。", "我當過接生婆，接過很多寶寶。現在我只接訂單。"], ["個頭飛得太快，啲頭髮會打結。冇身，冇手梳。", "頭飛太快頭髮會打結。沒身體，就沒手梳。"], ["人哋講「身首異處」係慘事。我叫佢做彈性上班。", "別人說「身首異處」很慘。我叫它彈性上班。"], ["飛行最驚撞到晾衫繩。", "飛行最怕撞到曬衣繩。"], ["夜晚飛出去，個月亮好圓。我都好圓——個頭嚟講。", "晚上飛出去，月亮很圓。我也很圓——以頭來說。", "夜"], ["倉庫缸醋係我嘅，唔該唔好攞嚟點餃子。", "倉庫那缸醋是我的，請不要拿來沾餃子。", "p:store"], ["贏咗！我飛一圈慶祝。身留低睇屋。", "贏了！我飛一圈慶祝。身體留下看家。", "win"], ["輸咗。我個身應該好擔心我……如果佢有頭諗嘢。", "輸了。我的身體應該很擔心我……如果它有頭可以想事情。", "lose"], ["{N}入村？我飛過去望吓。唔使行，好方便。", "{N}進村了？我飛過去看看。不用走，很方便。", "new"], ["冼小姐要我頭同身分開打卡。佢話咁先公平。", "冼小姐要我頭和身體分開打卡。她說這樣才公平。", "hr"], ["我買咗頂帽。", "我買了一頂帽子。", "arc:pena:1"], ["頂帽太大，飛起上嚟似一架 UFO。", "帽子太大，飛起來像一架 UFO。", "arc:pena:2"], ["隔籬村報咗警，話見到不明飛行物。係我。", "隔壁村報警了，說看到不明飛行物。是我。", "arc:pena:3"], ["龐總問我點解唔用全身返工。我答：我嘅身做緊另一份 part-time。", "龐總問我為什麼不全身上班。我說：我的身體在做另一份兼職。", "boss"], ["Bryan 話我「冇腳仔」。佢錯，我係冇身仔。", "Bryan 說我「沒有腳」。他錯了，我是沒有身體。", "rival"]], "mengpo": [["我嘅湯有三隻味：原味、唔記得、同埋唔記得頭先講咩。", "我的湯有三種口味：原味、忘記、還有忘記剛才說什麼。"], ["一千年冇放假，連自己幾歲都唔記得。職業病。", "一千年沒放假，連自己幾歲都忘了。職業病。"], ["包要趁熱食，好似人生咁，凍咗就冇咗。", "包子要趁熱吃，跟人生一樣，冷了就沒了。"], ["後生仔，少飲啲拉茶，多飲啲湯。", "年輕人，少喝點拉茶，多喝點湯。"], ["老身煮湯一千年，未試過有人話唔好飲。因為飲完佢哋都唔記得。", "老身煮湯一千年，沒人說過難喝。因為喝完他們都忘了。"], ["食少啲鹽，老身講咗一千年，冇人記得。", "少吃點鹽，老身說了一千年，沒人記得。"], ["你哋後生仔成日話「記住呀」。老身成世人都係幫人唔記得。", "你們年輕人總說「記得哦」。老身這輩子都在幫人忘記。"], ["老身退休之後，開始記嘢。第一樣記得嘅：退休金未出。", "老身退休後開始記事。第一件記住的：退休金還沒發。"], ["湯唔好滾太耐，人都一樣。", "湯不要滾太久，人也一樣。"], ["夜喇，飲碗熱湯先瞓。放心，呢碗係普通湯。", "很晚了，喝碗熱湯再睡。放心，這碗是普通的湯。", "夜"], ["朝早第一鑊包，老身一定親手蒸。第二鑊開始，交畀小紙。", "早上第一鍋包子，老身一定親手蒸。第二鍋起交給小紙。", "晨"], ["包子餡要七分肥三分瘦。人都一樣，太瘦唔好食。", "包子餡要七分肥三分瘦。人也一樣，太瘦不好吃。", "p:bun"], ["贏咗？老身煮碗糖水，慶祝。食完唔記得輸過。", "贏了？老身煮碗糖水慶祝。吃完就忘了輸過。", "win"], ["輸咗？飲碗湯啦。飲完你連打過都唔記得。", "輸了？喝碗湯吧。喝完你連打過都忘了。", "lose"], ["{N}嚟咗？老身記住佢名先……（停咗好耐）佢叫咩名？", "{N}來了？老身先記住他的名字……（停了很久）他叫什麼名字？", "new"], ["冼小姐叫老身交健康報告。老身交咗，但唔記得交咗未。", "冼小姐叫老身交健康報告。老身交了，但忘了有沒有交。", "hr"], ["老身開咗個 Facebook。", "老身開了個 Facebook。", "arc:mengpo:1"], ["老身唔記得個密碼，開咗第二個。", "老身忘了密碼，開了第二個。", "arc:mengpo:2"], ["老身而家有十七個 Facebook，全部 add 咗自己做朋友。", "老身現在有十七個 Facebook，全都互加自己好友。", "arc:mengpo:3"], ["龐總話要「記住公司嘅願景」。老身真係做唔到。", "龐總說要「記住公司的願景」。老身真的做不到。", "boss"], ["Bryan 飲咗老身一碗湯，之後唔記得自己欠人錢。佢好開心。", "Bryan 喝了老身一碗湯，然後忘了自己欠錢。他很開心。", "rival"]], "baiwu": [["我頂帽上面嗰四個字其實印錯咗，原本係「一見就收」。", "我帽子上那四個字其實印錯了，原本是「一見就收」。"], ["我哋公務員唔加班。加班嗰啲，最後都變咗我哋客。", "我們公務員不加班。加班的，最後都成了我們的客戶。"], ["條脷長嘅好處：食雪糕從來唔會滴落手。", "舌頭長的好處：吃冰淇淋從來不會滴到手。"], ["老黑話少，我話多。所以我哋係黃金拍檔。", "老黑話少，我話多。所以我們是黃金搭檔。"], ["笑口常開係我嘅職業要求。黑無常嘅職業要求：唔好笑。", "笑口常開是我的職業要求。黑無常的職業要求：不要笑。"], ["我負責管數，黑無常負責收數。分工好清楚。", "我管帳，黑無常收帳。分工很清楚。"], ["有人見到我會發財，有人見到我會發抖。視乎你有冇欠嘢。", "有人見到我會發財，有人見到我會發抖。看你有沒有欠東西。"], ["陰間公務員有長俸，不過要等你死咗先出。我哋已經死咗，所以……等緊。", "陰間公務員有退休金，不過要死了才發。我們已經死了，所以……在等。"], ["我頂帽高，入門口要彎腰。好似對每間屋鞠躬。", "我帽子高，進門要彎腰。好像在跟每間屋子鞠躬。"], ["夜晚勾魂嗰陣，我會講「晚安」。禮貌。", "晚上勾魂的時候，我會說「晚安」。禮貌。", "夜"], ["做工頭好，我最識講「辛苦晒」。", "當工頭很好，我最會說「辛苦了」。", "p:boss"], ["贏咗！一見生財！……我意思係，有獎金嗎？", "贏了！一見生財！……我的意思是，有獎金嗎？", "win"], ["輸咗冇問題，我可以幫你開張證明：「非戰之罪」。", "輸了沒問題，我可以幫你開證明：「非戰之罪」。", "lose"], ["{N}入村？我登記一下：姓名、死因、有冇欠債。", "{N}進村了？我登記一下：姓名、死因、有沒有欠債。", "new"], ["龐總同我傾咗半粒鐘 KPI。我哋公務員唔使理 KPI，但我好有禮貌咁聽完。", "龐總跟我聊了半小時 KPI。我們公務員不用管 KPI，但我很有禮貌地聽完了。", "boss"], ["我想換頂帽，寫新四個字。", "我想換頂帽子，寫新的四個字。", "arc:baiwu:1"], ["我諗咗「準時放工」。上頭話太敏感。", "我想了「準時下班」。上頭說太敏感。", "arc:baiwu:2"], ["最後批咗：「一見生財（新版）」。", "最後批下來的是：「一見生財（新版）」。", "arc:baiwu:3"], ["冼小姐問我哋公務員要唔要填年度考核。我話我哋考核係一千年一次。", "冼小姐問我們公務員要不要填年度考核。我說我們一千年考核一次。", "hr"], ["Bryan 問我點樣先可以「一見生財」。我話：見到我之前，先還清啲債。", "Bryan 問我怎樣才能「一見生財」。我說：見到我之前，先還清債。", "rival"]], "heiwu": [["天下太平，因為大家都死晒。", "天下太平，因為大家都死了。"], ["我勾魂從來唔遲到，準時過 RapidKL。", "我勾魂從不遲到，比 RapidKL 還準時。"], ["條鎖鏈係公家發嘅，整爛要寫三份報告。", "鎖鏈是公家發的，弄壞了要寫三份報告。"], ["……嗯。", "……嗯。"], ["話少，唔代表冇嘢講。代表講完你會驚。", "話少不代表沒話說。代表說完你會怕。"], ["老白講十句，我講一句。我嗰句通常係「行」。", "老白講十句，我講一句。我那句通常是「走」。"], ["我唔笑，唔係唔開心。係塊面冇呢個功能。", "我不笑，不是不開心。是臉沒這個功能。"], ["押送最緊要：唔好行快過犯人，佢會以為你急。", "押送最重要：不要走得比犯人快，他會以為你在趕。"], ["有人問我做呢行幾耐。我話：耐過你哋所有人嘅命加埋。", "有人問我做這行多久了。我說：比你們所有人的命加起來還久。"], ["……夜。返工。", "……晚上。上班。", "夜"], ["練陰兵，我一句：「行」。佢哋行咗三十年。", "練陰兵，我一句：「走」。他們走了三十年。", "p:camp"], ["……好。", "……好。", "win"], ["輸。……下次。", "輸了。……下次。", "lose"], ["{N}？……登記咗未？", "{N}？……登記了嗎？", "new"], ["龐總同我講咗一個鐘。我答咗一個字：「嗯」。佢話我好有領導才能。", "龐總跟我講了一個鐘頭。我回了一個字：「嗯」。他說我很有領導才能。", "boss"], ["Bryan 叫我「黑仔」。我望咗佢一眼。佢之後叫我「黑哥」。", "Bryan 叫我「小黑」。我看了他一眼。他之後叫我「黑哥」。", "rival"], ["我今日講咗三句說話。", "我今天說了三句話。", "arc:heiwu:1"], ["老白話我最近好多嘢講，問我係咪有心事。", "老白說我最近話很多，問我是不是有心事。", "arc:heiwu:2"], ["……冇。今日返返一句。", "……沒有。今天回到一句。", "arc:heiwu:3"], ["冼小姐叫我參加「溝通技巧工作坊」。我參加咗，冇出聲，拎咗證書。", "冼小姐叫我參加「溝通技巧工作坊」。我去了，沒出聲，拿了證書。", "hr"], ["我條鎖鏈而家用嚟晾衫。公家發嘅，要用盡。", "我的鎖鏈現在拿來曬衣服。公家發的，要用盡。", "mid"]], "tianhua": [["倉庫最高嗰格嘅塵，我抹咗。下面嗰啲，你哋自己嚟。", "倉庫最上層的灰，我擦了。下面的，你們自己來。"], ["天花板係我嘅辦公室。開放式，冇隔板，老闆睇唔到我。", "天花板是我的辦公室。開放式，沒隔板，老闆看不到我。"], ["風油唔係香水，係我人工。", "風油不是香水，是我的薪水。"], ["我唔係偷睇你哋。係條腰卡住咗，轉唔到。", "我不是在偷看你們。是腰卡住了，轉不過來。"], ["哎喲……我嘅腰。", "哎喲……我的腰。"], ["倒吊二十年，我睇嘢係倒轉嘅。你哋啲字我反而睇得順。", "倒吊二十年，我看東西是倒的。你們的字我反而看得順。"], ["我啲頭髮唔使夾，佢自己會跌落嚟。", "我的頭髮不用夾，它自己會垂下來。"], ["我推介：貼藥膏要貼喺背脊中間，自己貼唔到嗰度。所以要識朋友。", "我推薦：藥膏要貼背中間，自己貼不到那裡。所以要交朋友。"], ["人老咗，最驚兩樣嘢：落樓梯，同埋落天花板。", "人老了，最怕兩件事：下樓梯，還有下天花板。"], ["夜晚啲老鼠喺天花板上面行。佢哋係我同事。", "晚上老鼠在天花板上走。牠們是我的同事。", "夜"], ["倉庫最高嗰格，我一伸手就攞到。不過伸完要休息半個鐘。", "倉庫最高那格，我一伸手就拿到。不過伸完要休息半小時。", "p:store"], ["贏咗？好呀……（扶腰）我就唔拍手喇。", "贏了？好啊……（扶腰）我就不鼓掌了。", "win"], ["輸咗唔緊要。我條腰都輸咗二十年。", "輸了沒關係。我的腰也輸了二十年。", "lose"], ["{N}入村？佢腰好唔好？我介紹間跌打畀佢。", "{N}進村了？他腰好不好？我介紹間跌打館給他。", "new"], ["龐總抬頭望到我，嚇到跌咗部平板。所以我話：做人要識岳高頭。", "龐總抬頭看到我，嚇得掉了平板。所以我說：做人要懂得抬頭。", "boss"], ["我買咗張按摩椅。", "我買了一張按摩椅。", "arc:tianhua:1"], ["張按摩椅要坐喺地下用。我已經二十年冇坐過地下。", "那張按摩椅要坐在地上用。我已經二十年沒坐過地上了。", "arc:tianhua:2"], ["我將張按摩椅釘咗上天花板。效果好好，就係會跌。", "我把按摩椅釘在天花板上。效果很好，就是會掉下來。", "arc:tianhua:3"], ["冼小姐問我坐姿符唔符合職安健。我答：我冇坐姿，得吊姿。", "冼小姐問我坐姿符不符合職安規定。我答：我沒有坐姿，只有吊姿。", "hr"], ["Bryan 喺我下面講是非。佢唔知我聽得好清楚，天花板係傳聲嘅。", "Bryan 在我下面說閒話。他不知道我聽得很清楚，天花板會傳聲的。", "rival"]], "n30_qionggui": [["借住先，有錢即刻還……應該。", "先借我，有錢馬上還……應該。"], ["我件衫有十三個補丁，第十四個係補丁上面嘅補丁。", "我的衣服有十三個補丁，第十四個是補在補丁上的。"], ["人哋儲錢，我儲收據。至少收據唔會用完。", "別人存錢，我存收據。至少收據不會用完。"], ["我嘅理財秘訣：冇財，就唔使理。", "我的理財秘訣：沒有財，就不用理。"], ["冥幣通脹，我都冇感覺。零乘一千都係零。", "冥幣通脹，我也沒感覺。零乘一千還是零。"], ["我最鍾意「免費」兩個字。第二鍾意「試食」。", "我最喜歡「免費」兩個字。第二喜歡「試吃」。"], ["我個銀包好新，因為從來冇用過。", "我的錢包很新，因為從來沒用過。"], ["窮唔係問題，問題係大家都知我窮。", "窮不是問題，問題是大家都知道我窮。"], ["我食飯從來唔使 AA，因為冇人約我。", "我吃飯從來不用 AA，因為沒人約我。"], ["夜晚慳電，我冇開燈。其實我都冇燈。", "晚上省電，我沒開燈。其實我也沒有燈。", "夜"], ["斬柴最好，啲柴頭我可以執返屋企。", "砍柴最好，碎柴我可以撿回家。", "p:wood"], ["贏咗！有冇派利是？我唔介意細封。", "贏了！有沒有發紅包？我不介意小包的。", "win"], ["輸咗都冇所謂，我本身就冇嘢輸。", "輸了也無所謂，我本來就沒東西可輸。", "lose"], ["{N}入村喎。佢有冇舊衫唔要？", "{N}進村了。他有沒有不要的舊衣服？", "new"], ["龐總話要開源節流。我淨係識節流，因為冇源。", "龐總說要開源節流。我只會節流，因為沒有源。", "boss"], ["我執到一個銅錢。", "我撿到一個銅錢。", "arc:qiong:1"], ["我將個銅錢放咗喺枕頭底，每晚數一次。", "我把銅錢放在枕頭下，每晚數一次。", "arc:qiong:2"], ["孤寒鬼話佢上個月跌咗一個銅錢。我今晚瞓唔著。", "孤寒鬼說他上個月掉了一個銅錢。我今晚睡不著了。", "arc:qiong:3"], ["冼小姐話出糧之前要填銀行戶口。我寫：枕頭底。", "冼小姐說發薪前要填銀行帳戶。我寫：枕頭底下。", "hr"], ["Bryan 請大家飲嘢，冇請我。我企喺隔籬聞。", "Bryan 請大家喝東西，沒請我。我站在旁邊聞。", "rival"]], "n30_danxiao": [["你、你唔好嚇我呀……", "你、你不要嚇我啦……"], ["我自己係鬼，但係我好驚鬼。", "我自己是鬼，但我很怕鬼。"], ["我夜晚唔敢自己去廁所，要叫笑死鬼陪我。佢笑到我更驚。", "我晚上不敢自己去廁所，要叫笑死鬼陪我。他笑得我更怕。"], ["照鏡嗰陣，我會先閉埋眼。", "照鏡子的時候，我會先閉上眼睛。"], ["有人拍我膊頭，我嚇到飄咗上樹。原來係片葉。", "有人拍我肩膀，我嚇得飄上樹。原來是一片葉子。"], ["我最驚三樣嘢：黑、靜，同埋有人話「你身後……」。", "我最怕三樣東西：黑、安靜，還有人說「你後面……」。"], ["鬼故我聽唔得，因為入面啲鬼好似我識咁。", "鬼故事我聽不得，因為裡面的鬼好像我認識的。"], ["我每朝第一件事：數吓自己仲喺唔喺度。", "我每天早上第一件事：確認自己還在不在。"], ["人哋膽小如鼠。我問過隻老鼠，佢話佢膽大過我。", "人家說膽小如鼠。我問過老鼠，牠說牠膽子比我大。"], ["夜、夜晚喇……邊個熄咗燈？我？哦，係我。", "晚、晚上了……誰關的燈？我？哦，是我。", "夜"], ["倉庫好暗……我可唔可以帶埋提燈妖一齊返工？", "倉庫好暗……我可以帶提燈妖一起上班嗎？", "p:store"], ["贏、贏咗？真係？我頭先閉住眼，冇睇到。", "贏、贏了？真的？我剛才閉著眼，沒看到。", "win"], ["輸咗……我早就知。我一路都好驚。", "輸了……我早就知道。我一直都很怕。", "lose"], ["{N}入村？佢、佢惡唔惡？", "{N}進村了？他、他兇不兇？", "new"], ["龐總行過嚟，我匿咗喺棺材鋪。龐總以為我請咗病假。", "龐總走過來，我躲進了棺材鋪。龐總以為我請病假。", "boss"], ["我決定訓練膽量：每晚望窗外一分鐘。", "我決定練膽：每晚看窗外一分鐘。", "arc:danxiao:1"], ["第一晚望到轆轤首個頭飛過。我暈咗。", "第一晚看到轆轤首的頭飄過。我暈了。", "arc:danxiao:2"], ["第二晚我拉埋窗簾望。進度良好。", "第二晚我拉上窗簾再看。進度良好。", "arc:danxiao:3"], ["冼小姐叫我參加「勇氣工作坊」。工作坊喺墳場開。我冇去。", "冼小姐叫我參加「勇氣工作坊」。工作坊在墳場辦。我沒去。", "hr"], ["Bryan 喺我背後大叫一聲。我冇事，佢跌咗個波。", "Bryan 在我背後大叫一聲。我沒事，他的球掉了。", "rival"]], "n30_maoshi": [["唔好意思！我唔係故意㗎！", "對不起！我不是故意的！"], ["我今日跌咗七次。比尋日少一次，有進步。", "我今天摔了七次。比昨天少一次，有進步。"], ["我搬嘢，十件爛三件。另外七件係因為我冇掂到。", "我搬東西，十件破三件。另外七件是因為我沒碰到。"], ["我生前係踩到自己鞋帶跌死嘅。死咗之後……我冇鞋帶喇，但係仍然跌。", "我生前是踩到自己鞋帶摔死的。死後……我沒鞋帶了，但還是會摔。"], ["我唔係大頭蝦，我係大頭鬼。", "我不是粗心大意，我是粗心大鬼。"], ["有人話「慢慢嚟」。我慢慢嚟，慢慢跌。", "有人說「慢慢來」。我慢慢來，慢慢摔。"], ["我有一個優點：跌完會即刻企返起身。因為我好有經驗。", "我有一個優點：摔完馬上站起來。因為我很有經驗。"], ["我以前打碎過老闆個獎盃。佢話「冇所謂」，第二日我就冇咗份工。", "我以前打破過老闆的獎盃。他說「沒關係」，第二天我就沒了工作。"], ["我行路會撞門、撞柱、撞人。今日撞到自己。我都唔知點做到。", "我走路會撞門、撞柱子、撞人。今天撞到自己。我也不知道怎麼做到的。"], ["夜晚睇唔清楚，我會跌少啲。因為我唔敢郁。", "晚上看不清楚，我會少摔一點。因為我不敢動。", "夜"], ["做棺材板？好！……（嘭）唔好意思，嗰塊係做好咗嘅。", "做棺材板？好！……（砰）對不起，那塊是做好的。", "p:plank"], ["贏咗！我跳起身慶祝——（跌）冇事冇事！", "贏了！我跳起來慶祝——（摔倒）沒事沒事！", "win"], ["輸咗……係咪我頭先撞跌咗面旗？", "輸了……是不是我剛才撞倒了那面旗？", "lose"], ["{N}入村！我去幫佢搬行李！……啊，個行李！", "{N}進村了！我去幫他搬行李！……啊，行李！", "new"], ["龐總嚟巡，我好小心咁斟咗杯茶畀佢。杯茶好穩，係我跌。", "龐總來巡視，我很小心地倒了杯茶給他。茶很穩，是我摔了。", "boss"], ["我買咗對防滑鞋。", "我買了一雙防滑鞋。", "arc:maoshi:1"], ["對防滑鞋好有效。我而家唔會滑——我會絆親。", "防滑鞋很有效。我現在不會滑——我會絆倒。", "arc:maoshi:2"], ["膽小鬼話佢見我跌得多，已經唔驚喇。我幫到人！", "膽小鬼說他看我摔多了，已經不怕了。我幫到人了！", "arc:maoshi:3"], ["冼小姐要我填工傷表。我一個月填咗三十份，佢幫我印咗一本。", "冼小姐要我填工傷表。我一個月填了三十份，她幫我印成一本。", "hr"], ["Bryan 絆咗我一下，話係意外。我信，因為我都成日意外。", "Bryan 絆了我一下，說是意外。我信，因為我也常常意外。", "rival"]], "n30_yangui": [["咳咳……冇事，食多口就好。", "咳咳……沒事，抽一口就好。"], ["醫生話我要戒煙。我話醫生，你遲咗啲。", "醫生說我要戒菸。我說醫生，你晚了一點。"], ["我唔係煙鬼，我係「香」鬼。人哋拜我都係用香。", "我不是菸鬼，我是「香」鬼。人家拜我都是用香的。"], ["倉庫唔准食煙。我知，所以我喺門口食。煙自己飄入去。", "倉庫不准抽菸。我知道，所以我在門口抽。煙自己飄進去的。"], ["我咳一聲，成條村以為行雷。", "我咳一聲，全村以為在打雷。"], ["我戒過煙好多次。最長一次戒咗三分鐘。", "我戒過很多次菸。最長一次戒了三分鐘。"], ["我個肺黑過黑無常件衫。", "我的肺比黑無常的衣服還黑。"], ["燒香畀我嘅人越嚟越少，而家都用電子香。電子香冇味㗎。", "燒香給我的人越來越少，現在都用電子香。電子香沒味道的。"], ["我想做健康大使。冇人肯請。", "我想當健康大使。沒人肯請我。"], ["夜晚一個人企喺門口咳，好有型。我覺得。", "晚上一個人站在門口咳嗽，很有型。我覺得。", "夜"], ["倉庫好多易燃物，所以我食煙係喺好遠嗰度食。遠到我隻手伸入嚟。", "倉庫很多易燃物，所以我在很遠的地方抽。遠到我的手伸進來。", "p:store"], ["贏咗！我食……我意思係，深呼吸，慶祝。", "贏了！我抽……我是說，深呼吸，慶祝。", "win"], ["輸咗，咳咳，冇事，咳，我頂得順。", "輸了，咳咳，沒事，咳，我撐得住。", "lose"], ["{N}入村？佢食唔食煙？……唔食好，唔好學我。", "{N}進村了？他抽不抽菸？……不抽好，不要學我。", "new"], ["冼小姐喺我門口貼咗張「無煙職場」。我喺張紙後面食。", "冼小姐在我門口貼了「無菸職場」。我躲在紙後面抽。", "hr"], ["我決定改食香口膠。", "我決定改嚼口香糖。", "arc:yangui:1"], ["香口膠食完，我習慣咗去點火。", "口香糖嚼完，我習慣性地去點火。", "arc:yangui:2"], ["原來香口膠點唔著。我學到嘢。", "原來口香糖點不著。我學到了。", "arc:yangui:3"], ["龐總話我效率低，因為成日出去食煙。我話我食煙嗰陣諗緊公事。", "龐總說我效率低，因為常出去抽菸。我說我抽菸時在想公事。", "boss"], ["Bryan 借火。我冇畀，我話：你要嘅係人哋功勞，唔係火。", "Bryan 借火。我沒給，我說：你要的是別人的功勞，不是火。", "rival"]], "n30_jiugui": [["嗝～飲多杯先講啦！", "嗝～再喝一杯再說啦！"], ["我唔係醉，我係塊面天生紅。", "我不是醉，是我臉天生就紅。"], ["我個酒埕抱得實過條命。條命已經冇咗，所以抱實個埕。", "我抱酒罈比抱命還緊。命已經沒了，所以抱緊酒罈。"], ["人哋酒後吐真言。我酒後吐酒。", "人家酒後吐真言。我酒後吐酒。"], ["我飲咗一千杯，只係記得第一杯。之後啲杯都係佢嘅兄弟。", "我喝了一千杯，只記得第一杯。後面的都是它的兄弟。"], ["我最鍾意嘅運動：舉杯。", "我最喜歡的運動：舉杯。"], ["我唔識游水，但係我識浸。浸酒嗰種。", "我不會游泳，但我會泡。泡酒那種。"], ["飲酒唔好揸車。我好守規矩，我死咗都冇揸過。", "喝酒不開車。我很守規矩，死了也沒開過。"], ["人哋問我飲幾多。我答：唔多，一埕。", "別人問我喝多少。我說：不多，一罈。"], ["夜深人靜，最啱對月飲酒。月亮唔飲，我幫佢飲。", "夜深人靜，最適合對月喝酒。月亮不喝，我幫它喝。", "夜"], ["糯米田好，糯米可以釀酒。我諗咗成朝。", "糯米田很好，糯米可以釀酒。我想了一早上。", "p:rice"], ["贏咗！乾杯！嗝～", "贏了！乾杯！嗝～", "win"], ["輸咗？飲杯，就唔記得。孟婆話佢個湯都係咁原理。", "輸了？喝一杯就忘了。孟婆說她的湯也是這原理。", "lose"], ["{N}入村？今晚飲兩杯，歡迎佢！", "{N}進村了？今晚喝兩杯，歡迎他！", "new"], ["龐總話上班唔准飲酒。我話我冇飲，我淨係抱住。", "龐總說上班不准喝酒。我說我沒喝，我只是抱著。", "boss"], ["我決定少飲啲，改飲茶。", "我決定少喝一點，改喝茶。", "arc:jiugui:1"], ["飲茶好，我已經飲咗十杯。有啲醉。", "喝茶很好，我已經喝了十杯。有點醉了。", "arc:jiugui:2"], ["原來我個茶壺入面係酒。邊個放嘅？哦，係我。", "原來我茶壺裡裝的是酒。誰放的？哦，是我。", "arc:jiugui:3"], ["冼小姐問我有冇酗酒問題。我答：冇問題，酒好夠。", "冼小姐問我有沒有酗酒問題。我答：沒問題，酒很夠。", "hr"], ["Bryan 請我飲酒，想問我啲八卦。我飲晒，然後唔記得晒。", "Bryan 請我喝酒，想問我八卦。我喝光了，然後全忘了。", "rival"]], "n30_dugui": [["今鋪一定翻本！", "這一把一定翻本！"], ["我輸到淨低條短褲。條短褲都係借返嚟。", "我輸到只剩一條短褲。短褲也是借來的。"], ["我唔係賭，我係投資機率。", "我不是賭，我是投資機率。"], ["人生就好似擲骰：擲到六係好運，擲到一……再擲過。", "人生就像擲骰子：擲到六是好運，擲到一……再擲一次。"], ["我有個系統，包贏。個系統叫「下次」。", "我有一套系統，包贏。系統叫做「下次」。"], ["我嘅幸運數字係八。我今日輸咗八萬。", "我的幸運數字是八。我今天輸了八萬。"], ["人哋話十賭九輸。我每次都係嗰一次。……嗰九次。", "人家說十賭九輸。我每次都是那一次……那九次。"], ["我見到雀仔飛，都會賭佢飛左定飛右。", "我看到鳥飛，都會賭牠往左飛還是往右飛。"], ["我唔怕輸，我怕停。", "我不怕輸，我怕停。"], ["夜晚啲運氣特別好。尋晚都係咁講。", "晚上運氣特別好。昨晚也是這麼說的。", "夜"], ["派我管倉庫？你肯定？我淨係講吓，我好老實㗎。", "派我管倉庫？你確定？我只是說說，我很老實的。", "p:store"], ["贏咗！我就話啦！我押咗我哋贏！……押咗咩？唔好問。", "贏了！我就說吧！我押我們贏！……押了什麼？別問。", "win"], ["輸咗？冇事，下一場我押雙倍。", "輸了？沒事，下一場我押雙倍。", "lose"], ["{N}入村？佢識唔識玩鋤大D？", "{N}進村了？他會不會玩鋤大D？", "new"], ["龐總話 KPI 達標有獎金。我已經諗好押喺邊。", "龐總說 KPI 達標有獎金。我已經想好押在哪裡了。", "boss"], ["我話戒賭。", "我說要戒賭。", "arc:dugui:1"], ["村入面開咗盤，賭我戒唔戒到。", "村裡開了盤口，賭我戒不戒得了。", "arc:dugui:2"], ["我押咗自己戒唔到。贏咗。", "我押自己戒不掉。贏了。", "arc:dugui:3"], ["冼小姐話預支人工要寫原因。我寫：「機會唔等人」。", "冼小姐說預支薪水要寫原因。我寫：「機會不等人」。", "hr"], ["Bryan 同我賭佢入唔入到三分。佢入咗，我輸咗。佢又話係我幫佢傳波。", "Bryan 跟我賭他進不進三分球。他進了，我輸了。他又說是我傳的球。", "rival"]], "n30_guhangui": [["計清楚先，一毫都唔可以少。", "算清楚，一毛都不能少。"], ["我每個銅錢都要咬一啖驗真假。我嘅牙值錢過啲銅錢。", "每個銅錢我都要咬一口驗真假。我的牙比銅錢還值錢。"], ["請食飯？好呀，你請。", "請吃飯？好啊，你請。"], ["我冇開燈，因為我記得屋企啲嘢擺喺邊。", "我沒開燈，因為我記得家裡的東西放在哪裡。"], ["我嘅算盤係傳家寶。傳咗三代，我都未買過新嘅。", "我的算盤是傳家寶。傳了三代，我還沒買過新的。"], ["人哋話錢買唔到快樂。我同意，所以我唔使錢。", "人家說錢買不到快樂。我同意，所以我不花錢。"], ["我食包會食埋張包底紙。紙都有營養。", "我吃包子連包子底的紙都吃。紙也有營養。"], ["有人借我錢，我會即刻還。佢唔會借第二次，好正常。", "有人借我錢，我會馬上還。他不會借第二次，很正常。"], ["燒畀我嘅冥幣，我全部儲起。地府銀行利息好低，但係都係利息。", "燒給我的冥幣，我全存起來。地府銀行利息很低，但也是利息。"], ["夜晚我數錢，數完再數一次，確保佢冇偷偷生仔。", "晚上我數錢，數完再數一次，確保它沒偷偷變少。", "夜"], ["倉庫交畀我，我保證一粒米都唔會唔見——亦唔會出貨。", "倉庫交給我，保證一粒米都不會少——也不會出貨。", "p:store"], ["贏咗？慶功宴邊個畀錢？……我問吓啫。", "贏了？慶功宴誰付錢？……我只是問問。", "win"], ["輸咗？醫藥費邊個出？唔好望住我。", "輸了？醫藥費誰出？不要看我。", "lose"], ["{N}入村？佢有冇帶手信？冇？……都好，慳返。", "{N}進村了？他有沒有帶伴手禮？沒有？……也好，省了。", "new"], ["龐總話要削減成本。我好感動，終於有人明白我。", "龐總說要削減成本。我很感動，終於有人懂我了。", "boss"], ["我上個月跌咗一個銅錢。", "我上個月掉了一個銅錢。", "arc:guhan:1"], ["我搵咗成個月。我睇到窮鬼成日望住個枕頭。", "我找了一整個月。我看到窮鬼常常盯著他的枕頭。", "arc:guhan:2"], ["我決定唔追究。因為追究要使錢。", "我決定不追究。因為追究要花錢。", "arc:guhan:3"], ["冼小姐話公司聚餐要夾錢。我請咗病假。", "冼小姐說公司聚餐要湊錢。我請了病假。", "hr"], ["Bryan 請大家飲咖啡。我飲咗三杯，因為唔使錢。", "Bryan 請大家喝咖啡。我喝了三杯，因為不用錢。", "rival"]], "n30_taozhai": [["還錢！今日唔還，聽日再嚟！", "還錢！今天不還，明天再來！"], ["張欠單上面每個名都係真嘅。有幾個仲未出世。", "欠單上每個名字都是真的。有幾個還沒出生。"], ["我唔係壞人，我淨係好記性。", "我不是壞人，我只是記性好。"], ["你欠我嘅唔係錢，係信任。……同埋錢。", "你欠我的不是錢，是信任。……還有錢。"], ["我收數好有禮貌：先敲門，再敲門，再淋紅油。", "我討債很有禮貌：先敲門，再敲門，再潑紅油。"], ["我本簿仔記到第三百頁。第一頁係我自己欠人嘅，我撕咗。", "我的本子記到第三百頁。第一頁是我自己欠別人的，我撕了。"], ["紅油好貴，所以我淋得好準。", "紅油很貴，所以我潑得很準。"], ["我最鍾意月尾。月尾係收成期。", "我最喜歡月底。月底是收成期。"], ["有人話「債多唔愁」。我話：你唔愁，我愁。", "有人說「債多不愁」。我說：你不愁，我愁。"], ["夜晚敲門最有效，因為大家都喺屋企。", "晚上敲門最有效，因為大家都在家。", "夜"], ["管倉庫好，我可以順便點清楚邊個借咗嘢冇還。", "管倉庫很好，我可以順便點清楚誰借東西沒還。", "p:store"], ["贏咗！對方欠我哋一場勝利，今日收返。", "贏了！對方欠我們一場勝利，今天收回了。", "win"], ["輸咗？記低：對方欠我哋一場。", "輸了？記下：對方欠我們一場。", "lose"], ["{N}入村？我先睇吓佢喺唔喺我本簿度。", "{N}進村了？我先看看他在不在我的本子裡。", "new"], ["龐總問我收數技巧。我話：望住佢，唔好眨眼。佢眨咗。", "龐總問我討債技巧。我說：盯著他，不要眨眼。他眨了。", "boss"], ["賭鬼話下個月還我。", "賭鬼說下個月還我。", "arc:taozhai:1"], ["下個月到咗，賭鬼話「下個月」係指下下個月。", "下個月到了，賭鬼說「下個月」是指下下個月。", "arc:taozhai:2"], ["我而家喺佢門口開咗張枱返工。", "我現在在他家門口擺了張桌子上班。", "arc:taozhai:3"], ["冼小姐叫我唔好喺公司淋紅油。我改用紅色 highlighter。", "冼小姐叫我不要在公司潑紅油。我改用紅色螢光筆。", "hr"], ["Bryan 欠我兩杯咖啡錢。我記咗喺第一百頁。", "Bryan 欠我兩杯咖啡錢。我記在第一百頁。", "rival"]], "n30_diaosi": [["我條脷長過我條命，講嘢成日咬親。", "我的舌頭比我的命還長，講話常常咬到。"], ["食雪條我最叻，一舔就舔晒。", "吃冰棒我最厲害，一舔就舔完。"], ["我講嘢唔清楚，唔係我口齒唔好，係條脷太有個性。", "我講話不清楚，不是口齒不好，是舌頭太有個性。"], ["我舔郵票嘅速度，全村第一。", "我舔郵票的速度，全村第一。"], ["你哋聽唔明我講咩，冇所謂，我自己都唔係好明。", "你們聽不懂我說什麼，沒關係，我自己也不太懂。"], ["我條脷可以當領呔用。返工好方便。", "我的舌頭可以當領帶用。上班很方便。"], ["我飲湯唔使用匙羹。", "我喝湯不用湯匙。"], ["有人叫我「講少兩句」。我好想，但係條脷唔聽。", "有人叫我「少說兩句」。我很想，但舌頭不聽話。"], ["我同轆轤首鬥長。佢長頸，我長脷。佢贏。我唔服。", "我跟轆轤首比長。她脖子長，我舌頭長。她贏了。我不服。"], ["夜晚瞓覺，條脷要摺好放喺枕頭邊。", "晚上睡覺，舌頭要摺好放在枕頭邊。", "夜"], ["我包包好快，條脷幫手黏包口。……唔好問衛生唔衛生。", "我包包子很快，舌頭幫忙黏包口。……不要問衛不衛生。", "p:bun"], ["贏咗！我伸條脷做個勝利手勢！", "贏了！我伸出舌頭比個勝利手勢！", "win"], ["輸咗……唔緊要，我條脷都成日輸畀牙齒。", "輸了……沒關係，我的舌頭也常常輸給牙齒。", "lose"], ["{N}入村？我同佢打招呼：「歡……歡噫……」唉，又咬親。", "{N}進村了？我跟他打招呼：「歡……歡噫……」唉，又咬到。", "new"], ["龐總叫我「講重點」。我講咗，佢聽唔明。所以我冇重點。", "龐總叫我「講重點」。我講了，他聽不懂。所以我沒重點。", "boss"], ["我報咗演講班。", "我報了演講班。", "arc:diaosi:1"], ["導師話我咬字唔清。我話我咬嘅唔係字，係脷。", "老師說我咬字不清。我說我咬的不是字，是舌頭。", "arc:diaosi:2"], ["我畢業咗。導師話我「好有感染力」——佢俾我啲口水濺親。", "我畢業了。老師說我「很有感染力」——他被我的口水噴到了。", "arc:diaosi:3"], ["冼小姐話我條脷影響公司形象。我收埋喺頸巾入面。", "冼小姐說我的舌頭影響公司形象。我把它收進圍巾裡。", "hr"], ["Bryan 學我伸脷，扭親條筋。", "Bryan 學我伸舌頭，抽筋了。", "rival"]], "n30_wutou": [["你見唔見到我個頭？喺我手度。", "你看得到我的頭嗎？在我手上。"], ["我睇路靠手上個頭，所以成日撞牆。", "我看路靠手上的頭，所以常常撞牆。"], ["我抱住個頭行路，人哋以為我捧緊個西瓜。", "我抱著頭走路，人家以為我捧著西瓜。"], ["我最驚有人同我握手。我會唔記得我手上有嘢。", "我最怕有人跟我握手。我會忘記手上有東西。"], ["我啲頸巾好多，冇一條用得著。", "我有很多圍巾，一條都用不上。"], ["戴帽好麻煩，要先放低個頭。", "戴帽子很麻煩，要先把頭放下。"], ["我個頭會自己睇方向，我個身會自己行。通常意見唔同。", "我的頭自己看方向，身體自己走。通常意見不一樣。"], ["我擦皮鞋好叻，因為個頭可以放喺地下近距離睇。", "我擦皮鞋很厲害，因為頭可以放在地上近距離看。"], ["人哋話我「冇頭冇腦」。唔啱，我有，淨係擺錯位。", "人家說我「沒頭沒腦」。不對，我有，只是放錯位置。"], ["夜晚我將個頭放喺床頭，佢會幫我睇門口。", "晚上我把頭放在床頭，它會幫我看門口。", "夜"], ["斬柴要兩隻手，所以我將個頭放喺樹頭度睇住。", "砍柴要兩隻手，所以我把頭放在樹樁上看著。", "p:wood"], ["贏咗！我將個頭拋上天慶祝！……邊個幫我接？", "贏了！我把頭拋上天慶祝！……誰幫我接住？", "win"], ["輸咗……我個頭望住地下，我個身仲企得好直。", "輸了……我的頭低頭看地，身體還站得很直。", "lose"], ["{N}入村？我同佢點頭。……用手點。", "{N}進村了？我跟他點頭。……用手點。", "new"], ["龐總叫我「抬起頭做人」。我舉高咗隻手。", "龐總叫我「抬起頭做人」。我舉起了手。", "boss"], ["我個頭唔見咗！", "我的頭不見了！", "arc:wutou:1"], ["原來我個頭喺河童個盤度，佢以為係青瓜。", "原來我的頭在河童的盤子上，他以為是小黃瓜。", "arc:wutou:2"], ["我而家個頭貼咗張紙：「非青瓜」。", "我現在頭上貼了張紙：「不是小黃瓜」。", "arc:wutou:3"], ["冼小姐要我影證件相。我影咗兩張，一張頭，一張身。", "冼小姐要我拍證件照。我拍了兩張，一張頭，一張身體。", "hr"], ["Bryan 借我個頭打籃球。我冇畀。佢已經借咗人哋功勞。", "Bryan 想借我的頭打籃球。我沒給。他已經借了別人的功勞。", "rival"]], "n30_changgui": [["大佬，嗰邊有肉！", "老大，那邊有肉！"], ["我做咗老虎嘅助理三百年，佢從來冇加過我人工。", "我當老虎的助理三百年，牠從來沒幫我加薪。"], ["隻老虎唔肯返工，我自己頂上。我依家做埋老虎份工。", "老虎不肯上班，我自己頂上。我現在連老虎的工作也做了。"], ["「為虎作倀」唔係我想，係 job description 寫咗。", "「為虎作倀」不是我想的，是 job description 寫的。"], ["我好習慣幫人開路。今日幫餓鬼王開咗條路去包子鋪。", "我很習慣幫人開路。今天幫餓鬼王開了條路去包子鋪。"], ["我老細冇講多謝。但係老虎都唔識講嘢，我原諒佢。", "我老闆沒說謝謝。但老虎也不會說話，我原諒牠。"], ["我最叻就係擦鞋。以前擦老虎爪，而家擦龐總鞋。", "我最會擦鞋。以前擦老虎爪，現在擦龐總的鞋。"], ["人哋話我冇自己。我有，喺老虎肚入面。", "人家說我沒有自我。我有，在老虎肚子裡。"], ["我開咗個分享會，講點樣做個好倀鬼。冇人嚟，除咗 Bryan。", "我開了個分享會，講怎樣當個好倀鬼。沒人來，除了 Bryan。"], ["夜晚我會幫大家睇門口。習慣咗幫人睇風。", "晚上我會幫大家看門。習慣了幫人把風。", "夜"], ["做工頭？我唔慣，我一向係做工頭嘅工頭嘅助理。", "當工頭？我不習慣，我一直是工頭的工頭的助理。", "p:boss"], ["贏咗！大佬，你真係好犀利！……我慣咗咁講。", "贏了！老大，你真厲害！……我習慣這樣說了。", "win"], ["輸咗……唔係大佬嘅錯，係我開錯路。", "輸了……不是老大的錯，是我開錯路。", "lose"], ["{N}入村？大佬，使唔使我帶佢參觀？", "{N}進村了？老大，要不要我帶他參觀？", "new"], ["龐總一嚟，我條件反射行咗去佢後面。我要戒。", "龐總一來，我條件反射走到他後面。我要戒掉。", "boss"], ["我決定唔再跟住人。", "我決定不再跟著別人。", "arc:changgui:1"], ["唔跟人嘅第一日，我企咗喺村口成日，唔知去邊。", "不跟人的第一天，我在村口站了一整天，不知道去哪裡。", "arc:changgui:2"], ["第二日我跟住自己個影行。進步咗。", "第二天我跟著自己的影子走。進步了。", "arc:changgui:3"], ["冼小姐問我職業目標。我話：搵個好老細跟。佢話咁唔係目標。", "冼小姐問我職涯目標。我說：找個好老闆跟。她說這不算目標。", "hr"], ["Bryan 叫我做佢跟班。我差啲答應，好險。", "Bryan 叫我當他的跟班。我差點答應，好險。", "rival"]], "n30_guixinniang": [["良辰吉時，你都嚟埋啦。", "良辰吉時，你也一起來吧。"], ["我每晚喺村口等，唔知等緊邊個。等到我都覺得係習慣。", "我每晚在村口等，不知道在等誰。等到都成了習慣。"], ["我塊紅蓋頭好重，因為入面有隻蜘蛛。", "我的紅蓋頭很重，因為裡面住了一隻蜘蛛。"], ["我嫁妝有十二箱，全部係紙紮。最實用係部紙紮雪櫃。", "我嫁妝有十二箱，全是紙紮的。最實用的是紙紮冰箱。"], ["人哋問我幾時結婚。我已經結咗，佢未嚟。", "別人問我什麼時候結婚。我已經結了，他還沒來。"], ["我嘅喜帖派咗一百年，仲未派晒。", "我的喜帖發了一百年，還沒發完。"], ["蓋住頭行路好危險，我撞咗三次門。唔關我事，係門嘅位置唔吉利。", "蓋著頭走路很危險，我撞了三次門。不是我的錯，是門的位置不吉利。"], ["我最唔鍾意人哋話「你都係時候喇」。我已經過咗時候一百年。", "我最討厭人說「你也該嫁了」。我已經過了一百年。"], ["我條裙係大紅，所以我唔使搽胭脂。", "我的裙子是大紅色，所以我不用擦胭脂。"], ["子時喇，我出去等。你哋唔使等我。", "子時了，我出去等。你們不用等我。", "夜"], ["包壽包好，同我嫁妝個喜餅差唔多。都係冇人食。", "包壽包很好，跟我嫁妝的喜餅差不多。都沒人吃。", "p:bun"], ["贏咗！我掀起少少蓋頭睇吓……好！落返。", "贏了！我掀起一點蓋頭看看……好！放下來。", "win"], ["輸咗？冇事，我等慣咗，下次再嚟。", "輸了？沒事，我等習慣了，下次再來。", "lose"], ["{N}入村？……唔係佢。繼續等。", "{N}進村了？……不是他。繼續等。", "new"], ["冼小姐問我婚姻狀況。我答：已婚，等緊。佢唔知點剔格。", "冼小姐問我婚姻狀況。我答：已婚，在等。她不知道該勾哪一格。", "hr"], ["我喺村口裝咗個門鐘。", "我在村口裝了一個門鈴。", "arc:gxn:1"], ["門鐘響咗！……係 Bryan 撳錯。", "門鈴響了！……是 Bryan 按錯了。", "arc:gxn:2"], ["我將門鐘改咗做「請勿按錯」。今朝冇人撳，我好失望。", "我把門鈴改成「請勿按錯」。今早沒人按，我好失望。", "arc:gxn:3"], ["龐總問我等緊邊個，係咪客戶。我話：係，終身客戶。", "龐總問我在等誰，是不是客戶。我說：是，終身客戶。", "boss"], ["Bryan 話佢可以幫我搵老公。我拒絕咗。我唔想等多個。", "Bryan 說他可以幫我找老公。我拒絕了。我不想再多等一個。", "rival"]], "n30_baigujing": [["人哋只係想食少少唐伯嘅糖水啫。", "人家只是想喝一點唐伯的糖水嘛。"], ["我每日照鏡三個鐘。兩個鐘睇骨，一個鐘睇妝。", "我每天照鏡子三個鐘頭。兩小時看骨頭，一小時看妝。"], ["我唔使減肥，我已經淨低骨。", "我不用減肥，我只剩骨頭了。"], ["我變身好叻：變少女、變阿婆、變阿伯。最難係變「普通」。", "我變身很厲害：變少女、變阿婆、變阿伯。最難是變「普通人」。"], ["我啲骨頭會發光，夜晚唔使開燈。", "我的骨頭會發光，晚上不用開燈。"], ["化妝最難係畫顴骨。我顴骨太突出。", "化妝最難是畫顴骨。我的顴骨太突出了。"], ["人哋話我妖。我話：我叫精，有牌嘅。", "人家說我是妖。我說：我叫「精」，有執照的。"], ["我鍾意影相，但係相機淨係影到我副骨。濾鏡都救唔到。", "我喜歡拍照，但相機只拍得到我的骨頭。濾鏡也救不了。"], ["我最怕「X 光機」。佢會講真話。", "我最怕「X 光機」。它會說真話。"], ["夜晚我嘅骨頭特別白，係我最上鏡嘅時候。", "晚上我的骨頭特別白，是我最上鏡的時候。", "夜"], ["包子鋪？好，我變個阿婆樣，啲客會信多啲。", "包子鋪？好，我變成阿婆的樣子，客人會比較信。", "p:bun"], ["贏咗！我要變身影張靚相紀念！", "贏了！我要變身拍張美照紀念！", "win"], ["輸咗……唔緊要，我變個樣，就冇人認得係我輸。", "輸了……沒關係，我變個樣，就沒人認得是我輸的。", "lose"], ["{N}入村？佢靚定我靚？……唔好答，我知。", "{N}進村了？他漂亮還是我漂亮？……不用回答，我知道。", "new"], ["冼小姐話證件相要同真人一樣。我變咗十次，佢話十次都唔似。", "冼小姐說證件照要跟本人一樣。我變了十次，她說十次都不像。", "hr"], ["我開咗個美妝頻道。", "我開了個美妝頻道。", "arc:bgj:1"], ["第一集教「點樣遮骨」。三個 like，全部係我自己。", "第一集教「怎麼遮骨頭」。三個讚，全是我自己按的。", "arc:bgj:2"], ["第二集教「點樣露骨」。爆紅。原來大家想睇嘅係真實。", "第二集教「怎麼露骨頭」。爆紅。原來大家想看的是真實。", "arc:bgj:3"], ["龐總話我要「做返自己」。我問佢：邊個自己？我有十幾個。", "龐總說我要「做回自己」。我問他：哪個自己？我有十幾個。", "boss"], ["Bryan 讚我靚。我即刻知佢有嘢求我。", "Bryan 誇我漂亮。我馬上知道他有事要求我。", "rival"]], "n30_shanxiao": [["唔好燒爆竹呀！", "不要放鞭炮啦！"], ["我得一隻腳，但係跳得高過你哋兩隻腳。", "我只有一隻腳，但跳得比你們兩隻腳還高。"], ["過年係我最驚嘅季節。人哋過年，我過關。", "過年是我最怕的季節。別人過年，我過關。"], ["我買鞋好慳，一買就一隻。", "我買鞋很省，一買就一隻。"], ["鞋舖話一對先賣。我話我買一隻，送你另一隻。", "鞋店說要一雙才賣。我說我買一隻，另一隻送你。"], ["我喺山度住咗幾百年，第一次住村。啲屋好近，跳一跳就撞到。", "我在山裡住了幾百年，第一次住村子。房子好近，跳一下就撞到。"], ["我單腳企得好穩。瑜伽導師話我天生係「樹式」。", "我單腳站得很穩。瑜伽老師說我天生就是「樹式」。"], ["人哋話我獨腳山精。我叫自己「極簡主義」。", "人家叫我獨腳山精。我叫自己「極簡主義」。"], ["最驚聽到「拍拍手」。我得一隻手空。", "最怕聽到「拍拍手」。我只有一隻手空著。"], ["夜晚山風好大，我單腳企喺屋頂吹風，好有詩意。", "晚上山風很大，我單腳站在屋頂吹風，很有詩意。", "夜"], ["斬柴好，我熟樹。每棵樹我都識得佢個名。", "砍柴好，我熟悉樹。每棵樹我都知道它的名字。", "p:wood"], ["贏咗！我跳上屋頂慶祝！……落唔返嚟。", "贏了！我跳上屋頂慶祝！……下不來了。", "win"], ["輸咗？冇事，我跳返上山冷靜吓。", "輸了？沒事，我跳回山上冷靜一下。", "lose"], ["{N}入村？佢有冇帶爆竹？冇？好，可以做朋友。", "{N}進村了？他有沒有帶鞭炮？沒有？好，可以當朋友。", "new"], ["龐總話要「兩條腿走路」。我做唔到。", "龐總說要「兩條腿走路」。我做不到。", "boss"], ["有人話中秋都有煙花。", "有人說中秋也有煙火。", "arc:shanxiao:1"], ["我已經喺樹頂搵定位。", "我已經在樹頂找好位置了。", "arc:shanxiao:2"], ["原來中秋係玩燈籠。我喺樹頂等咗成晚，見到提燈妖行過。佢同我揮手。", "原來中秋是玩燈籠。我在樹頂等了一晚，看到提燈妖走過。它跟我揮手。", "arc:shanxiao:3"], ["冼小姐話職安健規定要著一對安全鞋。我著咗一隻，另一隻掛頸。", "冼小姐說職安規定要穿一雙安全鞋。我穿了一隻，另一隻掛在脖子上。", "hr"], ["Bryan 叫我同佢鬥跳高。我贏咗，佢話我犯規，因為我冇助跑。", "Bryan 叫我跟他比跳高。我贏了，他說我犯規，因為我沒助跑。", "rival"]], "n30_yecha": [["邊個夠膽過我條叉？", "誰敢過我這把叉？"], ["我把鋼叉每晚擦三次。擦完再擦，因為我驚佢唔開心。", "我的鋼叉每晚擦三次。擦完再擦，因為我怕它不開心。"], ["我青面獠牙，但係我好有禮貌。", "我青面獠牙，但很有禮貌。"], ["人哋見到我就走。我淨係想問路咋。", "別人看到我就跑。我只是想問路而已。"], ["我最鍾意嘅食物：豆腐。估唔到啩？", "我最喜歡的食物：豆腐。想不到吧？"], ["我把叉係古董，有人出價五十萬。我唔賣，佢係我老婆。", "我的叉是古董，有人出價五十萬。我不賣，它是我老婆。"], ["我隻牙咁長，刷牙要用兩支牙刷。", "我的牙這麼長，刷牙要用兩支牙刷。"], ["我晨運舉鐵，舉嘅係我把叉。", "我晨運舉重，舉的是我的叉。"], ["做夜叉好辛苦，日頭冇人請。", "當夜叉很辛苦，白天沒人請。"], ["夜晚係我主場。夜叉夜叉，個名都話咗。", "晚上是我的主場。夜叉夜叉，名字都說了。", "夜"], ["練陰兵我最叻，我一舉叉，佢哋就企直。", "練陰兵我最厲害，我一舉叉，他們就立正。", "p:camp"], ["贏咗！我條叉今晚加餐：擦多一次。", "贏了！我的叉今晚加餐：多擦一次。", "win"], ["輸咗……我條叉好失望。我要同佢傾吓。", "輸了……我的叉很失望。我要跟它談談。", "lose"], ["{N}入村？我去歡迎佢！……佢走咗。我講咗咩？", "{N}進村了？我去歡迎他！……他跑了。我說了什麼嗎？", "new"], ["龐總見到我把叉，即刻話「我哋唔使開會喇」。好用。", "龐總看到我的叉，馬上說「我們不用開會了」。很好用。", "boss"], ["我想學整豆腐花。", "我想學做豆花。", "arc:yecha:1"], ["我用把叉撈豆漿，撈咗三個鐘。", "我用叉子撈豆漿，撈了三個鐘頭。", "arc:yecha:2"], ["孟婆畀咗我一個匙羹。我第一次覺得自己被理解。", "孟婆給了我一支湯匙。我第一次覺得被理解。", "arc:yecha:3"], ["冼小姐話把叉係危險品，要登記。我登記咗佢做配偶。", "冼小姐說叉子是危險物品，要登記。我登記它為配偶。", "hr"], ["Bryan 想摸我條叉。我望咗佢一眼。佢改摸自己個波。", "Bryan 想摸我的叉。我看了他一眼。他改摸自己的球。", "rival"]], "n30_hanba": [["好熱……有冇凍檸茶？", "好熱……有沒有冰檸檬茶？"], ["我一行過，啲糯米田就乾晒。我唔係故意。", "我一走過，糯米田就乾了。我不是故意的。"], ["人哋講「求雨」，我係反面教材。", "人家說「求雨」，我是反面教材。"], ["我最想做嘅工：雪糕店。我最唔應該做嘅工：雪糕店。", "我最想做的工作：冰淇淋店。我最不該做的工作：冰淇淋店。"], ["我出街唔使遮，因為一定唔會落雨。", "我出門不用帶傘，因為一定不會下雨。"], ["曬衫揾我，十分鐘乾。曬魚乾揾我，五分鐘。", "曬衣服找我，十分鐘乾。曬魚乾找我，五分鐘。"], ["我飲水好快。唔係我口渴，係杯水自己蒸發。", "我喝水很快。不是我口渴，是水自己蒸發了。"], ["我同雪女唔啱。唔係性格，係溫度。", "我跟雪女合不來。不是性格，是溫度。"], ["有人叫我「熱情」。我其實好內向，淨係體溫高。", "有人說我「熱情」。我其實很內向，只是體溫高。"], ["夜晚涼啲，我終於可以出嚟行吓。……其實冇涼過，係我諗多咗。", "晚上涼一點，我終於可以出來走走。……其實沒涼，是我想多了。", "夜"], ["派我去糯米田？……你確定？", "派我去糯米田？……你確定？", "p:rice"], ["贏咗！熱烈慶祝！……我講「熱烈」係真係熱。", "贏了！熱烈慶祝！……我說的「熱烈」是真的熱。", "win"], ["輸咗，我需要冷靜。但係我冷唔到。", "輸了，我需要冷靜。但我冷不下來。", "lose"], ["{N}入村？佢怕唔怕熱？……我遲啲先去打招呼。", "{N}進村了？他怕不怕熱？……我晚點再去打招呼。", "new"], ["龐總話 KPI 要「熱起嚟」。我做到，佢件恤衫濕晒。", "龐總說 KPI 要「熱起來」。我做到了，他的襯衫全濕了。", "boss"], ["我買咗把風扇。", "我買了一台電風扇。", "arc:hanba:1"], ["把風扇吹出嚟係熱風。", "電風扇吹出來的是熱風。", "arc:hanba:2"], ["我將把風扇送咗畀凍死鬼。佢好感動，我都好感動。", "我把電風扇送給了凍死鬼。他很感動，我也很感動。", "arc:hanba:3"], ["冼小姐話辦公室冷氣唔夠凍，叫我坐遠啲。我坐咗出門口。", "冼小姐說辦公室冷氣不夠冷，叫我坐遠一點。我坐到了門外。", "hr"], ["Bryan 企喺我隔籬講是非，講到一半，佢個髮蠟溶咗。", "Bryan 站在我旁邊說閒話，說到一半，他的髮蠟融了。", "rival"]], "n30_pelesit": [["唧唧！唧唧唧！", "唧唧！唧唧唧！"], ["（唧）我翻譯：我今日好開心。", "（唧）翻譯：我今天很開心。"], ["（唧唧）我翻譯：邊個食咗我粒米？", "（唧唧）翻譯：誰吃了我那粒米？"], ["我叫起上嚟成晚唧唧聲。唔係我想，係我把聲嘅預設。", "我一叫就是一整晚唧唧聲。不是我想，是我聲音的預設值。"], ["我係使魔，但係冇主人。而家我個主人係……我自己。", "我是使魔，但沒有主人。現在我的主人是……我自己。"], ["人哋細個捉蟋蟀玩。而家輪到我捉佢哋。", "人家小時候抓蟋蟀玩。現在輪到我抓他們。"], ["我細細隻，但係我把聲大過 Banshee。……講笑，冇人大得過佢。", "我小小一隻，但聲音比 Banshee 大。……開玩笑，沒人比她大聲。"], ["（唧唧唧唧）我翻譯：唔好踩我。", "（唧唧唧唧）翻譯：不要踩我。"], ["我最驚嘅嘢：拖鞋。", "我最怕的東西：拖鞋。"], ["（唧唧唧唧唧——）夜晚我唔停得口。對唔住。", "（唧唧唧唧唧——）晚上我停不下來。對不起。", "夜"], ["糯米田好，好多草，好多朋友。", "糯米田很好，很多草，很多朋友。", "p:rice"], ["唧！唧唧唧！（翻譯：贏咗！我哋好叻！）", "唧！唧唧唧！（翻譯：贏了！我們好厲害！）", "win"], ["唧……（翻譯：輸咗，我唔想講嘢。）", "唧……（翻譯：輸了，我不想說話。）", "lose"], ["{N}入村？唧唧！（翻譯：佢有冇帶拖鞋？）", "{N}進村了？唧唧！（翻譯：他有沒有帶拖鞋？）", "new"], ["龐總開會，我唧咗一聲。龐總以為係佢部平板響。", "龐總開會，我唧了一聲。龐總以為是他的平板在響。", "boss"], ["我學緊講人話。", "我在學講人話。", "arc:pelesit:1"], ["我識講第一個字：「唧」。", "我學會了第一個字：「唧」。", "arc:pelesit:2"], ["老師話嗰個唔算。我話：喺我哋度係算。", "老師說那個不算。我說：在我們那裡是算的。", "arc:pelesit:3"], ["冼小姐話我夜晚太嘈，警告信一封。我收到之後，唧咗成晚表示抗議。", "冼小姐說我晚上太吵，警告信一封。我收到以後，唧了一整晚表示抗議。", "hr"], ["（唧唧）我翻譯：Bryan 又講大話。", "（唧唧）翻譯：Bryan 又在說謊。", "rival"]], "n30_polong": [["捧穩個樽呀，唔好打爛！", "捧穩瓶子啦，不要打破！"], ["我住喺個樽入面。租金零，但係好迫。", "我住在瓶子裡。租金零，但很擠。"], ["我要人捧住個樽先肯郁。唔係懶，係個樽冇腳。", "我要有人捧著瓶子才肯動。不是懶，是瓶子沒腳。"], ["我個樽係玻璃，所以我好怕跌。我同冒失鬼保持距離。", "我的瓶子是玻璃的，所以很怕摔。我跟冒失鬼保持距離。"], ["人哋問我住邊。我答：樽。", "別人問我住哪裡。我說：瓶子。"], ["樽口好細，所以我食飯要一粒一粒入。餓鬼王好明白我。", "瓶口很小，所以我吃飯要一粒一粒放進來。餓鬼王很懂我。"], ["我最鍾意人哋搖吓我個樽。好似坐過山車。", "我最喜歡人家搖我的瓶子。像坐雲霄飛車。"], ["有人想將我個樽拎去回收。我嗌救命嗌咗半個鐘。", "有人想把我的瓶子拿去回收。我喊救命喊了半小時。"], ["我個樽有標籤，寫住「請勿飲用」。好有自知之明。", "我的瓶子有標籤，寫著「請勿飲用」。很有自知之明。"], ["夜晚有月光照入樽，好似住咗間天窗屋。", "晚上月光照進瓶子，像住了一間有天窗的房子。", "夜"], ["倉庫好，個樽放喺架上面，冇人撞到。", "倉庫很好，瓶子放在架子上，沒人會撞到。", "p:store"], ["贏咗！搖我個樽慶祝！輕力啲輕力啲！", "贏了！搖我的瓶子慶祝！輕一點輕一點！", "win"], ["輸咗……我匿喺樽底冷靜吓。", "輸了……我躲在瓶底冷靜一下。", "lose"], ["{N}入村？佢住唔住樽？唔住？好可惜，好舒服㗎。", "{N}進村了？他住不住瓶子？不住？好可惜，很舒服的。", "new"], ["龐總話要「跳出框框」。我好想，但係我個樽冇框，得個樽口。", "龐總說要「跳出框框」。我很想，但我的瓶子沒框，只有瓶口。", "boss"], ["我想搬屋。", "我想搬家。", "arc:polong:1"], ["睇咗間大啲嘅：一個醬油樽。", "看了一間大一點的：一個醬油瓶。", "arc:polong:2"], ["搬咗入去，我而家成身豉油味。餓鬼王成日跟住我。", "搬進去以後，我現在全身醬油味。餓鬼王一直跟著我。", "arc:polong:3"], ["冼小姐話我嘅住址唔可以寫「樽」。我改咗：「玻璃樽，三樓架」。", "冼小姐說住址不能寫「瓶子」。我改成：「玻璃瓶，三樓架上」。", "hr"], ["Bryan 將我個樽當籃球射。入咗，但係我暈咗成日。", "Bryan 把我的瓶子當籃球投。進了，但我暈了一整天。", "rival"]], "n30_jenglot": [["嘶……唔好掂我啲頭髮。", "嘶……不要碰我的頭髮。"], ["我頭髮長過我個身三倍。洗頭要洗成晚。", "我的頭髮比身體長三倍。洗頭要洗一整晚。"], ["我指甲好長，但係唔使做 manicure，佢自己會捲。", "我的指甲很長，但不用做美甲，它自己會捲。"], ["我係乾屍，所以我唔怕熱。旱魃同我好啱傾。", "我是乾屍，所以不怕熱。旱魃跟我很聊得來。"], ["我細細隻，人哋以為我係公仔。有個小朋友想帶我返屋企。", "我小小一隻，別人以為我是玩偶。有個小朋友想帶我回家。"], ["我最憎人話「剪短啲啦」。你剪你自己啦。", "我最討厭人說「剪短一點吧」。你剪你自己啦。"], ["護髮素我一次用一支。", "護髮素我一次用一整瓶。"], ["我行路要拉住頭髮，好似拖婚紗。", "我走路要拉著頭髮，像拖婚紗。"], ["有人想買我嚟供。我話我唔接受供奉，我接受洗頭水。", "有人想買我回去供奉。我說我不接受供奉，我接受洗髮精。"], ["夜晚我啲頭髮會自己郁。唔使驚，佢哋只係伸懶腰。", "晚上我的頭髮會自己動。不用怕，它們只是伸懶腰。", "夜"], ["斬柴？我啲頭髮會勾住啲樹枝。我要帶埋梳。", "砍柴？我的頭髮會勾到樹枝。我要帶梳子。", "p:wood"], ["贏咗！嘶！（甩頭髮）", "贏了！嘶！（甩頭髮）", "win"], ["輸咗……我啲頭髮都垂低咗。", "輸了……我的頭髮也垂下來了。", "lose"], ["{N}入村？佢用咩牌子洗頭水？", "{N}進村了？他用什麼牌子的洗髮精？", "new"], ["龐總話要「梳理流程」。我借咗把梳畀佢。", "龐總說要「梳理流程」。我借了一把梳子給他。", "boss"], ["我想試新髮型。", "我想試新髮型。", "arc:jenglot:1"], ["髮型屋話要預約三日。因為要剪三日。", "髮廊說要預約三天。因為要剪三天。", "arc:jenglot:2"], ["最後我紮咗個辮。條辮長過村口條路。", "最後我綁了條辮子。辮子比村口那條路還長。", "arc:jenglot:3"], ["冼小姐話頭髮唔可以拖地，職安健問題。我捲咗喺頸度，好似條頸巾。", "冼小姐說頭髮不能拖地，職安問題。我捲在脖子上，像條圍巾。", "hr"], ["Bryan 踩住我條頭髮跌親。佢話係我絆佢。", "Bryan 踩到我的頭髮摔倒。他說是我絆他的。", "rival"]], "n30_hantugalah": [["你望咩呀？望上啲。", "你在看什麼？往上看一點。"], ["倉庫最高嗰格我一伸手就攞到。最低嗰格我要跪低。", "倉庫最高那格我一伸手就拿到。最低那格我要跪下來。"], ["我入屋要彎腰，出屋要彎腰。我條腰比我更辛苦。", "我進屋要彎腰，出屋也要彎腰。我的腰比我還辛苦。"], ["你越望我，我越高。所以唔好望。", "你越看我，我越高。所以不要看。"], ["我晾衫唔使晾衫竹，我自己就係竹。", "我曬衣服不用竹竿，我自己就是竹竿。"], ["我睇演唱會唔使擠前面。我企最後都睇到。後面啲人睇唔到。", "我看演唱會不用擠前面。站最後都看得到。後面的人就看不到了。"], ["我同天花姐好熟，我哋喺天花板見面。", "我跟天花姐很熟，我們在天花板見面。"], ["我量身高嗰陣，把尺唔夠長，要接三把。", "我量身高的時候，尺不夠長，要接三把。"], ["細個我好矮。之後有人望咗我一眼。", "小時候我很矮。後來有人看了我一眼。"], ["夜晚我企喺村口，幫大家睇遠啲。", "晚上我站在村口，幫大家看遠一點。", "夜"], ["倉庫最高嗰格，交畀我。最低嗰格，交畀 Toyol。", "倉庫最高那格交給我。最低那格交給 Toyol。", "p:store"], ["贏咗！我伸高隻手，同天打個招呼！", "贏了！我把手伸高，跟天打個招呼！", "win"], ["輸咗……我縮細少少，冷靜吓。", "輸了……我縮小一點，冷靜一下。", "lose"], ["{N}入村？我由上面睇到佢喇。佢個頭頂有粒飯。", "{N}進村了？我從上面看到他了。他頭頂有一粒飯。", "new"], ["龐總叫我「向上管理」。我已經好上。", "龐總叫我「向上管理」。我已經很上面了。", "boss"], ["有人叫我參加籃球隊。", "有人叫我參加籃球隊。", "arc:galah:1"], ["我一伸手就入波。教練話太容易，冇觀賞性。", "我一伸手就進球。教練說太容易，沒觀賞性。", "arc:galah:2"], ["而家我做籃球架。全隊最重要嘅隊員。", "現在我當籃球架。全隊最重要的隊員。", "arc:galah:3"], ["冼小姐要我量身高填表。表格得三格位寫數字，我寫唔落。", "冼小姐要我量身高填表。表格只有三格寫數字，我寫不下。", "hr"], ["Bryan 話佢高過我。佢企咗上張櫈。我望咗佢一眼，佢就矮咗。", "Bryan 說他比我高。他站上了椅子。我看了他一眼，他就矮了。", "rival"]], "n30_jerangkung": [["喀喀……等我裝返隻手先。", "喀喀……等我把手裝回去。"], ["我行路成日跌甩骨，要自己執返。今日執漏咗一條。", "我走路常常掉骨頭，要自己撿回來。今天漏撿了一根。"], ["我冇肉，所以唔怕瘦。", "我沒有肉，所以不怕瘦。"], ["我最鍾意嘅音樂：木琴。因為好似我自己。", "我最喜歡的音樂：木琴。因為很像我自己。"], ["夜晚行路好嘈，喀喀聲。啲狗以為有人敲門。", "晚上走路很吵，喀喀聲。狗以為有人敲門。"], ["我嘅骨頭有二百零六條。我數過，有幾日得二百零五。", "我的骨頭有兩百零六根。我數過，有幾天只有兩百零五根。"], ["有隻狗咬咗我條骨走。我追咗佢三條街。", "有隻狗咬了我一根骨頭跑掉。我追了牠三條街。"], ["我跳骷髏舞，觀眾話好有節奏感。因為我自己就係敲擊樂器。", "我跳骷髏舞，觀眾說很有節奏感。因為我自己就是打擊樂器。"], ["人哋話「瘦到見骨」。我係「骨到見瘦」。", "人家說「瘦到見骨」。我是「骨到見瘦」。"], ["夜晚月光照住我，我會發白光。好靚，好恐怖。", "晚上月光照著我，我會發白光。很美，很恐怖。", "夜"], ["做棺材板？我好有興趣。我未有過自己嘅棺材。", "做棺材板？我很有興趣。我還沒有自己的棺材。", "p:plank"], ["贏咗！我跳隻骷髏舞慶祝！喀喀喀喀！", "贏了！我跳一支骷髏舞慶祝！喀喀喀喀！", "win"], ["輸咗……我全身骨頭都散晒。字面意思。", "輸了……我全身骨頭都散了。字面上的意思。", "lose"], ["{N}入村？我同佢握手。……佢拎住我隻手走咗。", "{N}進村了？我跟他握手。……他拿著我的手走了。", "new"], ["龐總話要「精簡架構」。我已經精簡到淨低骨架。", "龐總說要「精簡架構」。我已經精簡到只剩骨架了。", "boss"], ["我唔見咗一條肋骨。", "我少了一根肋骨。", "arc:jkg:1"], ["原來條肋骨畀河童攞咗去做筷子。", "原來那根肋骨被河童拿去當筷子。", "arc:jkg:2"], ["河童還返畀我，仲幫我洗乾淨。我而家有一條特別白嘅肋骨。", "河童還給我了，還幫我洗乾淨。我現在有一根特別白的肋骨。", "arc:jkg:3"], ["冼小姐要我做身體檢查。醫生睇完 X 光，話：「同正常一樣。」", "冼小姐要我做健康檢查。醫生看完 X 光說：「跟正常一樣。」", "hr"], ["Bryan 借咗我條骨做鼓棍。還返嗰陣多咗一條。我都唔知係邊個嘅。", "Bryan 借了我一根骨頭當鼓棒。還回來時多了一根。我也不知道是誰的。", "rival"]], "n30_bunian": [["你睇唔到我，但係我一直喺度。", "你看不到我，但我一直都在。"], ["我斬完一棵樹，冇人見過我。所以冇人讚我。", "我砍完一棵樹，沒人看見我。所以沒人誇我。"], ["我住喺森林，啲屋你哋睇唔到。所以我冇收過差餉。", "我住在森林裡，房子你們看不到。所以我從來沒收過門牌稅單。"], ["你哋講我壞話，我都聽到。我就喺你隔籬。", "你們說我壞話，我都聽得到。我就在你旁邊。"], ["我最慘：開會冇人知我出席。", "我最慘：開會沒人知道我出席了。"], ["我影相從來都係空白。部相機好誠實。", "我拍照從來都是空白。相機很誠實。"], ["人哋叫我「精靈」。我唔係會飛嗰種，我係隱形嗰種。", "人家叫我「精靈」。我不是會飛那種，是隱形那種。"], ["排隊我一定排第一，因為冇人見到我。", "排隊我一定排第一，因為沒人看到我。"], ["我送禮物畀人，人哋以為係自己唔記得買過。", "我送禮物給人，別人以為是自己忘了買過。"], ["夜晚我會喺樹林度唱歌。如果你聽到，嗰個係我。", "晚上我會在樹林裡唱歌。如果你聽到，那就是我。", "夜"], ["我斬咗三棵樹。你數吓。……你數唔到，因為你睇唔到我。", "我砍了三棵樹。你數數看。……你數不到，因為你看不到我。", "p:wood"], ["贏咗！我喺你隔籬拍手。你聽唔到？我拍得好大力。", "贏了！我在你旁邊鼓掌。你聽不到？我拍得很用力。", "win"], ["輸咗……冇人見到我喊。都好。", "輸了……沒人看到我哭。也好。", "lose"], ["{N}入村？我已經同佢打咗招呼。佢唔知。", "{N}進村了？我已經跟他打過招呼。他不知道。", "new"], ["龐總點名，冇點到我。我已經連續缺席三個月，冇扣人工。", "龐總點名，沒點到我。我已經連續缺席三個月，沒扣薪水。", "boss"], ["我決定畀人見到我。", "我決定讓別人看到我。", "arc:bunian:1"], ["我企咗喺村口，大家都行過，冇人停低。", "我站在村口，大家都走過去，沒人停下來。", "arc:bunian:2"], ["原來我已經畀人見到咗。佢哋淨係唔理我。好似返到人間返工咁。", "原來大家看得到我了。他們只是不理我。好像回到人間上班一樣。", "arc:bunian:3"], ["冼小姐話我缺席太多。我話我一直喺度。佢話「證據呢？」我話：你張櫈係咪暖咗？", "冼小姐說我缺席太多。我說我一直都在。她說「證據呢？」我說：你的椅子是不是暖的？", "hr"], ["Bryan 講是非，講到我嗰度。佢唔知我企喺佢後面。我記低咗。", "Bryan 說閒話，說到我頭上。他不知道我站在他後面。我記下來了。", "rival"]], "n30_hanturaya": [["主人叫我做咩，我就做咩。", "主人叫我做什麼，我就做什麼。"], ["我扮成主人去打工，所以打卡記錄好亂。", "我扮成主人去上班，所以打卡記錄很亂。"], ["我係個大黑影，最怕開燈。", "我是一個大黑影，最怕開燈。"], ["我主人退休咗，我冇。我仲做緊佢份工。", "我主人退休了，我沒有。我還在做他的工作。"], ["我可以變成你個樣去開會。你喺屋企瞓覺就得。……要唔要試？", "我可以變成你的樣子去開會。你在家睡覺就好。……要不要試試？"], ["人哋請替工要錢。我係免費替工，所以冇人感激我。", "別人請代班要付錢。我是免費代班，所以沒人感激我。"], ["中午太陽最猛，我會縮到最細。好似放午飯。", "中午太陽最大，我會縮到最小。像在放午休。"], ["我最怕嘅問題：「你自己想點？」", "我最怕的問題：「你自己想怎樣？」"], ["我替過一個人返工十年。佢老細話佢「近年好穩定」。", "我替一個人上了十年班。他老闆說他「近年很穩定」。"], ["夜晚係我最大嘅時候。我大到遮住成條村。對唔住。", "晚上是我最大的時候。我大到遮住整個村子。對不起。", "夜"], ["做工頭？我可以扮成你啲工人，一個做三個。", "當工頭？我可以扮成你的工人，一個頂三個。", "p:boss"], ["主人贏咗！我都贏咗！……我係咪應該咁講？", "主人贏了！我也贏了！……我應該這樣說嗎？", "win"], ["輸咗……主人，我可以扮成你，去同對方道歉。", "輸了……主人，我可以扮成你，去跟對方道歉。", "lose"], ["{N}入村？佢需唔需要替工？", "{N}進村了？他需不需要代班？", "new"], ["龐總問我係咪本人。我話我係本人嘅影。佢話：「都算。」", "龐總問我是不是本人。我說我是本人的影子。他說：「也算。」", "boss"], ["阿福叫我放一日假。", "阿福叫我放一天假。", "arc:raya:1"], ["我唔識放假。我扮成阿福去放假。", "我不會放假。我扮成阿福去放假。", "arc:raya:2"], ["結果村民以為阿福曠工，阿福畀冼小姐警告。對唔住。", "結果村民以為阿福曠工，阿福被冼小姐警告。對不起。", "arc:raya:3"], ["冼小姐話我同主人要分開兩張合約。我簽咗兩張，用兩種筆跡。", "冼小姐說我跟主人要分開兩份合約。我簽了兩份，用兩種筆跡。", "hr"], ["Bryan 叫我扮成佢去開會，佢去打波。我拒絕咗。我唔替冇良心嘅人。", "Bryan 叫我扮成他去開會，他去打球。我拒絕了。我不替沒良心的人。", "rival"]], "n30_genderuwo": [["吼！邊個收埋咗我隻蕉？", "吼！誰藏了我的香蕉？"], ["我鍾意捉弄人，成日收埋人哋隻拖鞋。今日收咗二十隻。", "我喜歡捉弄人，常常藏別人的拖鞋。今天藏了二十隻。"], ["我好多毛，所以唔使著衫。冼小姐唔同意。", "我毛很多，所以不用穿衣服。冼小姐不同意。"], ["我笑起上嚟好大聲，但係我好怕羞。", "我笑起來很大聲，但我很害羞。"], ["我住喺大樹，同 Pontianak 做鄰居。佢笑我又笑，成晚好熱鬧。", "我住在大樹上，跟 Pontianak 當鄰居。她笑我也笑，整晚很熱鬧。"], ["我梳毛要梳成朝。所以我成日遲到。", "我梳毛要梳一早上。所以常常遲到。"], ["我扮人好叻，但係個尾會露出嚟。", "我扮人很厲害，但尾巴會露出來。"], ["有人送咗一梳蕉畀我。我好感動，食完先記得多謝。", "有人送了一串香蕉給我。我很感動，吃完才想起要道謝。"], ["人哋見到我喊「大猩猩」。我其實係鬼，比猩猩高級。", "別人看到我喊「大猩猩」。我其實是鬼，比猩猩高級。"], ["夜晚我喺樹頂望星。我數到第三粒就瞓著。", "晚上我在樹頂看星星。數到第三顆就睡著了。", "夜"], ["斬柴好！我一手拗一棵！……啊，唔係拗，係斬。", "砍柴好！我一手折一棵！……啊，不是折，是砍。", "p:wood"], ["贏咗！吼！（捶心口）", "贏了！吼！（捶胸口）", "win"], ["輸咗……我收埋自己喺樹頂冷靜。", "輸了……我躲到樹頂冷靜。", "lose"], ["{N}入村？我送佢一隻拖鞋做見面禮。……係佢自己隻。", "{N}進村了？我送他一隻拖鞋當見面禮。……是他自己的那隻。", "new"], ["龐總嚟巡，我收埋咗佢隻鞋。佢單腳行咗成個村。山魈好開心。", "龐總來巡視，我藏了他的鞋。他單腳走了整個村子。山魈好開心。", "boss"], ["大家話我收埋太多拖鞋。", "大家說我藏了太多拖鞋。", "arc:gend:1"], ["我決定還返。但係我唔記得邊隻係邊個。", "我決定還回去。但我忘了哪隻是誰的。", "arc:gend:2"], ["我開咗個拖鞋失物認領處。生意好過包子鋪。", "我開了一個拖鞋失物招領處。生意比包子鋪還好。", "arc:gend:3"], ["冼小姐話我一定要著衫返工。我著咗件背心。佢話：「……都算。」", "冼小姐說我一定要穿衣服上班。我穿了件背心。她說：「……也算。」", "hr"], ["Bryan 隻波鞋喺我度。佢搵咗成日。我仲未決定還唔還。", "Bryan 的球鞋在我這裡。他找了一整天。我還沒決定要不要還。", "rival"]], "n30_phiam": [["借個胸口坐吓啫，唔使咁驚。", "借你胸口坐一下而已，不用這麼怕。"], ["人哋話「鬼壓床」。我唔係壓，我係坐。好大分別。", "人家說「鬼壓床」。我不是壓，是坐。差很多。"], ["我派去顧倉，坐低就瞓著咗。我嘅工作性質係咁。", "我被派去看倉庫，一坐下就睡著了。我的工作性質就是這樣。"], ["而家啲人瞓唔著，個個碌手機碌到三點。我坐喺佢胸口等佢瞓，等到我自己瞓著。", "現在的人都睡不著，滑手機滑到三點。我坐在他胸口等他睡，等到我自己睡著了。"], ["我好輕，大約一包米咁重。一包十公斤嗰種。", "我很輕，大概一包米那麼重。十公斤那種。"], ["人哋醒咗見到我會嗌。我都會嗌，因為我都嚇親。", "別人醒來看到我會尖叫。我也會叫，因為我也被嚇到。"], ["我做呢行好多年，冇一個客畀過好評。", "我做這行很多年，沒有一個客人給過好評。"], ["我最鍾意嘅床：厚褥。最唔鍾意：吊床。坐唔穩。", "我最喜歡的床：厚床墊。最不喜歡：吊床。坐不穩。"], ["我唔使返工時間，因為我嘅工作係人哋放工之後。", "我沒有上班時間，因為我的工作在別人下班之後。"], ["夜喇，到我返工。唔好意思，邊個想第一個？", "晚上了，我上班了。不好意思，誰想當第一個？", "夜"], ["倉庫……好舒服……（呼——）", "倉庫……好舒服……（呼——）", "p:store"], ["贏咗？好……我坐低慶祝……（呼——）", "贏了？好……我坐下來慶祝……（呼——）", "win"], ["輸咗……我搵個胸口坐吓，平靜吓心情。", "輸了……我找個胸口坐一下，平靜心情。", "lose"], ["{N}入村？佢瞓邊間？……我淨係問吓。", "{N}進村了？他睡哪一間？……我只是問問。", "new"], ["龐總開會開到一半瞓著咗。唔關我事，我坐喺隔籬張櫈。", "龐總開會開到一半睡著了。不關我的事，我坐在隔壁椅子上。", "boss"], ["我報咗失眠治療班，做導師。", "我報了失眠治療班，當講師。", "arc:phiam:1"], ["第一堂學員全部瞓著咗，我都瞓著咗。", "第一堂學員全睡著了，我也睡著了。", "arc:phiam:2"], ["第二堂冇人嚟。佢哋話第一堂已經醫好咗。", "第二堂沒人來。他們說第一堂已經治好了。", "arc:phiam:3"], ["冼小姐話我上班瞓覺，要扣人工。我話我嘅 job description 就係瞓覺。佢翻查咗，真係。", "冼小姐說我上班睡覺，要扣薪水。我說我的工作內容就是睡覺。她查了，真的是。", "hr"], ["Bryan 開會講大話，我坐喺佢心口。佢即刻講真話。", "Bryan 開會說謊，我坐上他胸口。他馬上說真話。", "rival"]], "n30_churel": [["跟住我啲腳印行？你會行錯路喎。", "跟著我的腳印走？你會走錯路喔。"], ["我對腳係反嘅。我行向前，腳印指向後。", "我的腳是反的。我往前走，腳印指向後面。"], ["人哋追我，跟住腳印走，結果走咗返屋企。", "別人追我，跟著腳印走，結果走回家了。"], ["我著鞋要著反，著正就行唔到。", "我穿鞋要反著穿，穿正就走不了。"], ["跳舞我最叻：moonwalk。我天生就係。", "跳舞我最厲害：月球漫步。我天生就會。"], ["我長頭髮遮住面，因為我唔想人哋知我望緊邊個方向。", "我長頭髮遮住臉，因為不想讓人知道我在看哪個方向。"], ["我去邊度都會遲到。因為我要諗清楚邊邊係前面。", "我去哪裡都會遲到。因為我要想清楚哪邊是前面。"], ["我同 Tikbalang 一齊行街。我哋兩個都唔知自己喺邊。好開心。", "我跟 Tikbalang 一起逛街。我們兩個都不知道自己在哪裡。很開心。"], ["運動鞋廣告叫「向前行」。我一隻都冇買。", "運動鞋廣告說「向前走」。我一雙都沒買。"], ["夜晚出去散步，我啲腳印嚇親巡夜嘅陰兵。", "晚上出去散步，我的腳印嚇到巡夜的陰兵。", "夜"], ["割稻好，我行去邊，啲稻就向反方向倒。好有藝術感。", "割稻好，我走到哪，稻子就往反方向倒。很有藝術感。", "p:rice"], ["贏咗！我向前跑……其實係向後跑。都係慶祝。", "贏了！我往前跑……其實是往後跑。都是慶祝。", "win"], ["輸咗？我退後兩步……其實係向前。冷靜吓。", "輸了？我退後兩步……其實是往前。冷靜一下。", "lose"], ["{N}入村？我去接佢。你哋唔好跟我腳印。", "{N}進村了？我去接他。你們不要跟著我的腳印。", "new"], ["龐總話「向前看」。我做唔到，我淨係識向後行向前。", "龐總說「向前看」。我做不到，我只會往後走向前。", "boss"], ["我報咗步操隊。", "我參加了步操隊。", "arc:churel:1"], ["教官話「向前走」，成隊向前，我向後。", "教官喊「向前走」，全隊往前，我往後。", "arc:churel:2"], ["教官話我係隊入面最有個性嘅。佢將我調咗去做隊尾——其實係隊頭。", "教官說我是隊裡最有個性的。他把我調去隊尾——其實是隊頭。", "arc:churel:3"], ["冼小姐話打卡要「入」同「出」。我打「入」，機顯示「出」。", "冼小姐說打卡要打「進」和「出」。我打「進」，機器顯示「出」。", "hr"], ["Bryan 跟住我腳印想搵我收埋嘅嘢。佢行咗出村口。", "Bryan 跟著我的腳印想找我藏的東西。他走出了村口。", "rival"]], "n30_tikbalang": [["條路？我帶你行……行到天光。", "路？我帶你走……走到天亮。"], ["帶我出門，一定蕩失路。唔係我唔識路，係條路唔識我。", "帶我出門一定迷路。不是我不認路，是路不認我。"], ["我馬頭長腳，人哋以為我係賽馬。我跑得慢過烏龜。", "我馬頭長腿，人家以為我是賽馬。我跑得比烏龜還慢。"], ["我食煙斗，但係我唔係煙鬼。我係有品味嘅馬。", "我抽菸斗，但不是菸鬼。我是有品味的馬。"], ["有人話騎我會發達。冇人騎得上，因為我太高。", "有人說騎我會發財。沒人騎得上，因為我太高了。"], ["我用 Waze，Waze 都話「重新計算路線」。", "我用 Waze，Waze 都說「重新計算路線」。"], ["我啲鬃毛好靚，我每日梳兩次。", "我的鬃毛很漂亮，我每天梳兩次。"], ["我最鍾意問路。佢哋話「直行」，我就轉左。", "我最喜歡問路。他們說「直走」，我就左轉。"], ["我同人約喺村口，結果我喺村尾等咗三個鐘。", "我跟人約在村口，結果在村尾等了三個鐘頭。"], ["夜晚我出去行吓。如果天光未返，唔使搵我，我好快返。", "晚上我出去走走。如果天亮還沒回來，不用找我，我很快就回來。", "夜"], ["去伐木場？……喺邊？", "去伐木場？……在哪裡？", "p:wood"], ["贏咗！我跑一圈慶祝！……有冇人知我跑咗去邊？", "贏了！我跑一圈慶祝！……有沒有人知道我跑去哪裡了？", "win"], ["輸咗……我出去行吓，諗吓。遲啲返。可能聽日。", "輸了……我出去走走，想一想。晚點回來。可能明天。", "lose"], ["{N}入村？我去接佢！……佢比我早到。", "{N}進村了？我去接他！……他比我先到。", "new"], ["龐總叫我帶佢去巡倉庫。我哋巡咗三條村。", "龐總叫我帶他去巡倉庫。我們巡了三個村子。", "boss"], ["我決定學睇地圖。", "我決定學看地圖。", "arc:tik:1"], ["我買咗一張地圖。我拎反咗兩日先發覺。", "我買了一張地圖。拿反了兩天才發現。", "arc:tik:2"], ["我而家識睇地圖喇。我搵到自己喺邊：喺地圖外面。", "我現在會看地圖了。我找到自己在哪：在地圖外面。", "arc:tik:3"], ["冼小姐話我遲到太多。我話我冇遲，我只係去咗第二度先嚟。", "冼小姐說我遲到太多。我說我沒遲到，我只是先去了別的地方。", "hr"], ["Bryan 叫我帶佢抄近路。佢而家應該仲喺山度。", "Bryan 叫我帶他抄近路。他現在應該還在山裡。", "rival"]], "n30_maenak": [["Mak 收工未呀？", "Mak 下班了沒？"], ["我每晚喺門口等老公收工。等咗一百幾年。佢應該好多 OT。", "我每晚在門口等老公下班。等了一百多年。他應該很多加班。"], ["我隻手好長，可以喺廚房伸手落樓下摘芒果。", "我的手很長，可以在廚房伸手到樓下摘芒果。"], ["我煮飯好好食。老公一直話「下次返嚟食」。", "我煮飯很好吃。老公一直說「下次回來吃」。"], ["我條手伸長嚟執地下嘢，好方便。不過嚇親送外賣嘅。", "我伸長手撿地上的東西，很方便。不過嚇到外送員了。"], ["我最鍾意唱歌。我唱，成條村都聽到。佢哋未必鍾意。", "我最喜歡唱歌。我一唱，全村都聽得到。他們不一定喜歡。"], ["我好賢慧：煮飯、洗衫、等人。三樣都好熟手。", "我很賢慧：煮飯、洗衣、等人。三樣都很熟練。"], ["有人問我點解唔放手。我話：我隻手太長，放唔到。", "有人問我為什麼不放手。我說：我的手太長，放不下。"], ["我同 Pontianak 好熟。我哋都係等人嘅專家。", "我跟 Pontianak 很熟。我們都是等人的專家。"], ["夜喇，我煮定飯，等佢返。你哋要唔要食？煮多咗。", "晚上了，我煮好飯等他回來。你們要不要吃？煮多了。", "夜"], ["包子鋪好，我隻手伸得長，啲包一伸就擺好。", "包子鋪好，我的手伸得長，包子一伸就擺好。", "p:bun"], ["贏咗！今晚加餸！", "贏了！今晚加菜！", "win"], ["輸咗？冇事，返屋企食飯先。", "輸了？沒事，先回家吃飯。", "lose"], ["{N}入村？我煮多一碗飯。", "{N}進村了？我多煮一碗飯。", "new"], ["龐總成日留到好夜。我叫佢早啲返屋企，屋企有人等。佢話冇。我好同情佢。", "龐總常常留到很晚。我叫他早點回家，家裡有人等。他說沒有。我很同情他。", "boss"], ["我喺門口裝咗盞燈，等老公返。", "我在門口裝了一盞燈，等老公回來。", "arc:maenak:1"], ["盞燈引咗好多飛蛾。佢哋陪我等。", "燈引來很多飛蛾。牠們陪我等。", "arc:maenak:2"], ["而家我有一百隻飛蛾朋友。老公仲未返，但我唔再寂寞。", "現在我有一百隻飛蛾朋友。老公還沒回來，但我不再寂寞了。", "arc:maenak:3"], ["冼小姐問我緊急聯絡人。我寫咗老公。佢打過去，電話仲喺度響。", "冼小姐問我緊急聯絡人。我寫了老公。她打過去，電話還在響。", "hr"], ["Bryan 偷食我煮嘅飯。我隻手伸咗去佢屋企，攞返個碗。", "Bryan 偷吃我煮的飯。我把手伸到他家，拿回了碗。", "rival"]], "n30_aswang": [["日頭我係普通人嚟㗎。", "白天我是普通人啦。"], ["日頭我係賣菜嘅，夜晚我……都係賣菜，不過啲菜會驚。", "白天我賣菜，晚上我……也賣菜，不過菜會怕。"], ["我變身要十分鐘。最麻煩係變返轉頭，要搵返對鞋。", "我變身要十分鐘。最麻煩是變回來，要找回鞋子。"], ["我一入夜就變樣，所以我從來唔接夜晚嘅 Zoom。", "我一入夜就變樣，所以從不接晚上的 Zoom。"], ["我隻翼好大，但係晾衫唔方便。", "我的翅膀很大，但曬衣服不方便。"], ["人哋話我兩面人。我話：我係日夜班人。", "人家說我是雙面人。我說：我是日夜班人。"], ["我個鼻好靈，邊間屋煮咩我一聞就知。餓鬼王同我開咗個群組。", "我的鼻子很靈，哪家煮什麼我一聞就知道。餓鬼王跟我開了個群組。"], ["我最怕大蒜。所以我唔去 pasar malam 嘅 BBQ 檔。", "我最怕大蒜。所以不去夜市的燒烤攤。"], ["日頭我好有禮貌，夜晚……我都好有禮貌，淨係大隻咗。", "白天我很有禮貌，晚上……我也很有禮貌，只是變大隻了。"], ["夜喇。唔好望我，我換緊衫——換緊身。", "晚上了。不要看我，我在換衣服——在換身體。", "夜"], ["天光喇，我要變返人樣去開檔。邊個見到我對鞋？", "天亮了，我要變回人樣去開攤。誰看到我的鞋？", "晨"], ["贏咗！我拍翼慶祝！小心頭髮。", "贏了！我拍翅膀慶祝！小心頭髮。", "win"], ["輸咗……我變返人樣冷靜吓。人樣冷靜啲。", "輸了……我變回人樣冷靜一下。人樣比較冷靜。", "lose"], ["{N}入村？佢日頭定夜晚嗰款？", "{N}進村了？他是白天款還是晚上款？", "new"], ["龐總話要「一致性」。我做唔到，我日夜唔同。", "龐總說要「一致性」。我做不到，我日夜不一樣。", "boss"], ["我想參加選美。", "我想參加選美。", "arc:aswang:1"], ["評判問我日頭定夜晚出賽。我話兩樣都得。", "評審問我白天還是晚上參賽。我說兩樣都可以。", "arc:aswang:2"], ["我日頭得咗「最佳親和力」，夜晚得咗「最佳特技」。兩個獎座。", "我白天拿了「最佳親和力」，晚上拿了「最佳特效」。兩座獎盃。", "arc:aswang:3"], ["冼小姐要我證件相。我交咗兩張，一張日頭，一張夜晚。佢揀咗日頭。", "冼小姐要我的證件照。我交了兩張，一張白天，一張晚上。她選了白天。", "hr"], ["Bryan 夜晚撞到我，嚇到跌咗個波。佢第二日話係佢嚇我。", "Bryan 晚上撞見我，嚇得球都掉了。第二天他說是他嚇我。", "rival"]], "n30_vetala": [["估吓先：乜嘢越洗越污糟？", "猜猜看：什麼東西越洗越髒？"], ["答案係：水。你估唔到？咁你唔走得住。", "答案是：水。猜不到？那你先別走。"], ["我倒吊住，所以我睇世界係反嘅。我覺得係你哋反。", "我倒掛著，所以看世界是反的。我覺得是你們反了。"], ["我出謎題唔係為咗難你，係我太悶。", "我出謎語不是為了難你，是我太無聊。"], ["有人答啱我嘅謎題，我好開心，但係我又要搵第二條。好攰。", "有人答對我的謎語，我很開心，但又要想下一題。好累。"], ["我倒吊咗一千年，血都喺個頭度。所以我好聰明。", "我倒掛了一千年，血都在頭上。所以我很聰明。"], ["估吓：乜嘢有頭冇身，有身冇頭？答：無頭鬼同佢個頭。", "猜猜：什麼有頭沒身，有身沒頭？答：無頭鬼和他的頭。"], ["我最鍾意嘅樹：大榕樹。夠枝吊。", "我最喜歡的樹：大榕樹。樹枝夠多可以掛。"], ["有人背我行咗成晚，我講咗成晚故事。佢最後話：「求你唔好再講。」", "有人背著我走了一整晚，我講了一整晚故事。他最後說：「求你別再講了。」"], ["夜晚謎題時間。估吓：乜嘢嘢夜晚先出現？……我。", "晚上猜謎時間。猜猜：什麼東西晚上才出現？……我。", "夜"], ["倉庫有好多橫樑，好正。我可以邊吊邊點貨。", "倉庫有很多橫樑，很好。我可以邊掛邊點貨。", "p:store"], ["贏咗！估吓點解？……因為我哋叻。答啱。", "贏了！猜猜為什麼？……因為我們厲害。答對了。", "win"], ["輸咗。估吓點解？……唔好答，我知。", "輸了。猜猜為什麼？……不用回答，我知道。", "lose"], ["{N}入村？我要出條謎題迎接佢。", "{N}進村了？我要出一道謎語迎接他。", "new"], ["龐總答唔到我條謎題，所以佢今日唔走得。佢好開心，第一次唔使返工。", "龐總答不出我的謎語，所以今天走不了。他很開心，第一次不用上班。", "boss"], ["我想出一條冇人答到嘅謎題。", "我想出一道沒人答得出的謎語。", "arc:vetala:1"], ["我諗咗三日。條謎題係：「我諗緊咩？」", "我想了三天。謎語是：「我在想什麼？」", "arc:vetala:2"], ["孟婆答啱咗：「你唔記得。」佢係對嘅。", "孟婆答對了：「你忘了。」她是對的。", "arc:vetala:3"], ["冼小姐面試要我答問題。我反問咗佢三條。佢錄用咗我，因為佢未答到。", "冼小姐面試要我回答問題。我反問了她三題。她錄取了我，因為她還沒答出來。", "hr"], ["Bryan 答我條謎題，抄咗冒失鬼個答案。冒失鬼答錯，佢都錯。", "Bryan 答我的謎語，抄了冒失鬼的答案。冒失鬼答錯，他也錯。", "rival"]], "n30_banshee": [["啊——！……唔好意思，習慣咗。", "啊——！……不好意思，習慣了。"], ["我一開口，成條村都要掩住耳。", "我一開口，全村都要摀住耳朵。"], ["我係報喪女妖。而家冇喪可以報，我改咗報天氣。", "我是報喪女妖。現在沒喪可以報，我改報天氣。"], ["我把梳係銀嘅，唔好借。上次借咗畀 Jenglot，梳齒斷晒。", "我的梳子是銀的，別借。上次借給 Jenglot，梳齒全斷了。"], ["我喊起上嚟好大聲。但係我其實好少傷心，我淨係嗓門大。", "我哭起來很大聲。但我其實很少傷心，只是嗓門大。"], ["有人請我做 KTV 主唱。佢哋第二日裝咗隔音板。", "有人請我當 KTV 主唱。他們第二天裝了隔音板。"], ["我梳頭要梳一百下。我會數出聲。", "我梳頭要梳一百下。我會大聲數。"], ["我講悄悄話，隔籬村都聽到。", "我說悄悄話，隔壁村都聽得到。"], ["我最驚圖書館。", "我最怕圖書館。"], ["今晚好靜……啊——！唔好意思，打噴嚏。", "今晚好安靜……啊——！不好意思，打噴嚏。", "夜"], ["朝早我叫大家起身，唔使鬧鐘。", "早上我叫大家起床，不用鬧鐘。", "晨"], ["贏咗！啊————！（開心嗰種）", "贏了！啊————！（開心的那種）", "win"], ["輸咗……啊——！（唔開心嗰種）", "輸了……啊——！（不開心的那種）", "lose"], ["{N}入村！我大聲歡迎佢！……佢掩住耳走咗。", "{N}進村了！我大聲歡迎他！……他摀著耳朵跑了。", "new"], ["龐總話開會要「發聲」。我發咗。佢之後再冇叫我開會。", "龐總說開會要「發聲」。我發了。之後他再也沒叫我開會。", "boss"], ["我想做圖書館管理員。", "我想當圖書館管理員。", "arc:banshee:1"], ["第一日我叫人「請保持安靜」。三排書架倒咗。", "第一天我叫人「請保持安靜」。三排書架倒了。", "arc:banshee:2"], ["而家我做圖書館嘅火警鐘。好適合。", "現在我當圖書館的火災警鈴。很適合。", "arc:banshee:3"], ["冼小姐話我噪音超標，要戴口罩上班。我戴咗，口罩飛咗。", "冼小姐說我噪音超標，要戴口罩上班。我戴了，口罩飛走了。", "hr"], ["Bryan 喺我耳邊講是非。我答咗一聲「係咩？」佢聾咗三日。", "Bryan 在我耳邊說閒話。我回了一聲「是嗎？」他聾了三天。", "rival"]], "n30_kasaobake": [["落雨喇！帶埋我出街啦！", "下雨了！帶我出門啦！"], ["我得一隻眼、一隻腳、一條脷。極簡主義。", "我只有一隻眼、一隻腳、一條舌頭。極簡主義。"], ["我以前係把遮，用咗一百年畀人掉咗。所以我變咗鬼。報復方式：落雨唔畀人用。", "我以前是一把傘，用了一百年被丟掉了。所以變成鬼。報復方式：下雨不讓人用。"], ["晴天我好悶，企喺牆角諗人生。", "晴天我很無聊，站在牆角想人生。"], ["我最驚大風。上次我反咗，成晚收唔返。", "我最怕大風。上次我被吹翻了，一整晚收不回來。"], ["我舔人一下，係表示友好。唔好誤會。", "我舔人一下，是表示友好。不要誤會。"], ["我單腳跳出街，啲人以為我係新款玩具。", "我單腳跳出門，人家以為我是新款玩具。"], ["有人叫我「縮骨遮」。我唔係，我係傳統手工。", "有人叫我「折疊傘」。我不是，我是傳統手工的。"], ["我同雨水係好朋友，同太陽係陌生人。", "我跟雨水是好朋友，跟太陽是陌生人。"], ["落雨嘅夜晚最正。我會出去單腳跳一圈。", "下雨的晚上最棒。我會出去單腳跳一圈。", "夜"], ["糯米田要水，我幫佢哋遮咗。……唔係咁？", "糯米田要水，我幫它們遮住了。……不是這樣嗎？", "p:rice"], ["贏咗！我轉個圈慶祝！啲水濺晒你身。", "贏了！我轉一圈慶祝！水濺你一身。", "win"], ["輸咗……我收埋自己，企喺牆角。", "輸了……我把自己收起來，站在牆角。", "lose"], ["{N}入村？佢有冇遮？冇？好！我有工開！", "{N}進村了？他有沒有傘？沒有？好！我有工作了！", "new"], ["龐總話「未雨綢繆」。我好開心，終於有人講到我。", "龐總說「未雨綢繆」。我好開心，終於有人提到我。", "boss"], ["我想去旅行。去一個成日落雨嘅地方。", "我想去旅行。去一個常下雨的地方。", "arc:kasa:1"], ["人哋話：你已經喺馬來西亞。", "人家說：你已經在馬來西亞了。", "arc:kasa:2"], ["我決定唔去旅行。我已經喺天堂。", "我決定不去旅行。我已經在天堂了。", "arc:kasa:3"], ["冼小姐問我有冇其他技能。我話：我識擋雨同埋擋事。", "冼小姐問我有沒有其他技能。我說：我會擋雨，也會擋事。", "hr"], ["Bryan 借我去遮雨，遮完唔還。我自己單腳跳返嚟。", "Bryan 借我去遮雨，用完不還。我自己單腳跳回來。", "rival"]], "n30_chochin": [["要唔要我照你返屋企？", "要不要我照你回家？"], ["夜市冇電，全靠我照住。電費全免。", "夜市沒電，全靠我照著。電費全免。"], ["我個口張開好大，唔係想食你，係我嘅燈罩爛咗。", "我嘴張這麼大，不是想吃你，是我燈罩破了。"], ["我條脷好長，係燈芯。", "我的舌頭很長，是燈芯。"], ["我最驚嘅嘢：大風同大雨。同唐傘妖做朋友之後，我驚少一樣。", "我最怕的東西：大風和大雨。跟唐傘妖當朋友後，我少怕一樣。"], ["中秋節係我嘅主場，其他日子我係配角。", "中秋節是我的主場，其他日子我是配角。"], ["我照得唔夠光，但係好有氣氛。", "我照得不夠亮，但很有氣氛。"], ["有人想將我換做 LED 燈。我一晚冇瞓。", "有人想把我換成 LED 燈。我一整晚沒睡。"], ["我照住人行路，佢哋從來唔多謝我，淨係多謝月光。", "我照著人走路，他們從不謝我，只謝月光。"], ["夜喇，我開工。邊個要照？", "晚上了，我上班了。誰要照？", "夜"], ["天光喇，我可以熄燈休息。我其實好驚光，好諷刺。", "天亮了，我可以熄燈休息。我其實很怕光，很諷刺。", "晨"], ["贏咗！我閃三下慶祝！", "贏了！我閃三下慶祝！", "win"], ["輸咗……我暗咗少少。", "輸了……我暗了一點。", "lose"], ["{N}入村？我照住佢行入嚟，等佢唔好撞到門。", "{N}進村了？我照著他走進來，免得他撞到門。", "new"], ["龐總話要「照亮前路」。我照咗，佢話太暗。我盡咗力。", "龐總說要「照亮前路」。我照了，他說太暗。我盡力了。", "boss"], ["我想換個新燈罩。", "我想換個新燈罩。", "arc:chochin:1"], ["紙紮鋪話新燈罩要訂。三個月。", "紙紮店說新燈罩要訂。三個月。", "arc:chochin:2"], ["小紙幫我補咗個燈罩，用佢件衫。佢而家冇衫著，但係我好光。", "小紙用她的衣服幫我補了燈罩。她現在沒衣服穿，但我好亮。", "arc:chochin:3"], ["冼小姐話我屬於「明火」，要放喺指定位置。我而家喺廁所門口。好多人多謝我。", "冼小姐說我屬於「明火」，要放在指定位置。我現在在廁所門口。很多人謝我。", "hr"], ["Bryan 喺黑暗入面講是非，我照住佢。佢即刻收聲。", "Bryan 在黑暗中說閒話，我照著他。他馬上閉嘴。", "rival"]], "n30_kappa": [["有冇青瓜呀？", "有沒有小黃瓜？"], ["我收工要食三條青瓜。唔係貪食，係充電。", "我下班要吃三條小黃瓜。不是貪吃，是充電。"], ["我頭頂個盤唔可以乾，乾咗我就冇力。所以我最驚鞠躬，盤水會倒晒。好矛盾。", "我頭上的盤子不能乾，乾了就沒力。所以我最怕鞠躬，水會倒光……很矛盾。"], ["人哋同我鞠躬，我一定要鞠返。所以我同人保持距離。", "別人跟我鞠躬，我一定要回禮。所以我跟人保持距離。"], ["我游水好快，但係我唔鍾意游泳池。氯氣太重。", "我游泳很快，但不喜歡游泳池。氯太重了。"], ["我最鍾意嘅壽司：青瓜卷。第二鍾意：青瓜卷。", "我最喜歡的壽司：小黃瓜卷。第二喜歡：小黃瓜卷。"], ["我個殼唔係背包，唔好問我借嘢放。", "我的殼不是背包，不要問我借地方放東西。"], ["我同水鬼係同行。佢搵替身，我搵青瓜。", "我跟水鬼是同行。他找替身，我找小黃瓜。"], ["落雨天我最開心，個盤自動加水。", "下雨天我最開心，盤子自動加水。"], ["夜晚我去河邊浸吓，充充電。", "晚上我去河邊泡一泡，充充電。", "夜"], ["糯米田好，有水。不過冇青瓜。可唔可以種啲？", "糯米田很好，有水。不過沒有小黃瓜。可以種一點嗎？", "p:rice"], ["贏咗！我食條青瓜慶祝。兩條。", "贏了！我吃一條小黃瓜慶祝。兩條。", "win"], ["輸咗……我個盤乾咗少少。邊個有水？", "輸了……我的盤子乾了一點。誰有水？", "lose"], ["{N}入村？佢有冇帶青瓜？", "{N}進村了？他有沒有帶小黃瓜？", "new"], ["龐總同我鞠躬。我鞠返，個盤水倒晒落佢對鞋度。", "龐總跟我鞠躬。我回禮，盤子的水全倒在他鞋上。", "boss"], ["我喺屋後種咗青瓜。", "我在屋後種了小黃瓜。", "arc:kappa:1"], ["啲青瓜生得好好。旱魃行過咗一次。", "小黃瓜長得很好。旱魃走過了一次。", "arc:kappa:2"], ["而家我有一園青瓜乾。原來都好好食。", "現在我有一園小黃瓜乾。原來也很好吃。", "arc:kappa:3"], ["冼小姐要我喺工作期間除帽。我話呢個唔係帽，係器官。", "冼小姐要我工作時脫帽。我說這不是帽子，是器官。", "hr"], ["Bryan 偷咗我條青瓜。我追咗佢三條街，佢跌咗落河。我救咗佢，我好專業。", "Bryan 偷了我的小黃瓜。我追了他三條街，他掉進河裡。我救了他，我很專業。", "rival"]], "n30_nopperabo": [["我個樣係咪好普通？", "我的長相是不是很普通？"], ["朝九晚五，從來冇遲到過。除咗今日。", "朝九晚五，從來沒遲到過。除了今天。"], ["我冇面，所以我唔驚冇面。", "我沒有臉，所以不怕丟臉。"], ["我開會從來唔會畀人睇穿我諗咩。因為冇嘢睇。", "開會從來沒人看得穿我在想什麼。因為沒東西可看。"], ["我整呔整得好正。冇面嘅人，最緊要係衣著。", "我領帶打得很好。沒臉的人，最重要的是穿著。"], ["我唔使化妝，慳咗好多錢。", "我不用化妝，省了很多錢。"], ["我嘅情緒：平靜、平靜、同埋平靜。你睇唔到其他。", "我的情緒：平靜、平靜、還有平靜。你看不到別的。"], ["有人話我「冇表情」。唔啱，我係「冇面」。表情我有，喺心入面。", "有人說我「沒表情」。不對，我是「沒臉」。表情我有，在心裡。"], ["返工最好：冇人知我係咪喺度瞓覺。", "上班最好：沒人知道我是不是在睡覺。"], ["夜晚出街，我帶個面具。唔係嚇人，係唔想嚇人。", "晚上出門，我戴個面具。不是嚇人，是不想嚇人。", "夜"], ["朝早我會先抹抹塊面。抹完冇分別，但係係儀式感。", "早上我會先擦擦臉。擦完沒差別，但這是儀式感。", "晨"], ["贏咗。（我好開心，你睇唔到。）", "贏了。（我很開心，你看不到。）", "win"], ["輸咗。（我好傷心，你都睇唔到。）", "輸了。（我很難過，你也看不到。）", "lose"], ["{N}入村？我同佢笑一笑。佢冇反應，因為佢睇唔到。", "{N}進村了？我對他笑一笑。他沒反應，因為他看不到。", "new"], ["龐總話我「好專業，冇情緒」。佢唔知我心入面鬧緊佢。", "龐總說我「很專業，沒情緒」。他不知道我心裡在罵他。", "boss"], ["我想試吓畫個面。", "我想試著畫一張臉。", "arc:noppe:1"], ["白骨精幫我畫咗。畫完我似龐總。", "白骨精幫我畫了。畫完我像龐總。", "arc:noppe:2"], ["我即刻抹咗佢。冇面好過似龐總。", "我馬上擦掉了。沒臉總比像龐總好。", "arc:noppe:3"], ["冼小姐要我喺員工證相「笑一笑」。我笑咗。張相同之前一樣。", "冼小姐要我在員工證照片上「笑一笑」。我笑了。照片跟之前一樣。", "hr"], ["Bryan 話我冇面見人。我話：至少我冇兩副面。", "Bryan 說我沒臉見人。我說：至少我沒有兩張臉。", "rival"]], "n30_rokurokubi": [["唔好意思，我條頸瞓覺唔聽話。", "不好意思，我的脖子睡覺不聽話。"], ["夜晚瞓覺我個頭會周圍去。今朝喺廚房醒。", "晚上睡覺我的頭會到處跑。今天早上在廚房醒來。"], ["我條頸可以伸到二樓。所以我住一樓，睇埋二樓。", "我的脖子可以伸到二樓。所以我住一樓，順便看二樓。"], ["頸巾我要買十條，駁埋先夠長。", "圍巾我要買十條，接起來才夠長。"], ["我睇電影唔使買前排飛。", "我看電影不用買前排的票。"], ["我最驚有人同我講「伸長條頸等」。我真係會。", "我最怕有人跟我說「伸長脖子等」。我真的會。"], ["我條頸打結咗，要搵三個人幫我解。", "我的脖子打結了，要找三個人幫我解開。"], ["我好鍾意八卦。條頸長，聽得遠。", "我很喜歡八卦。脖子長，聽得遠。"], ["我晾衫唔使夾，掛喺條頸度就得。", "我曬衣服不用夾子，掛在脖子上就好。"], ["我今晚會好好瞓。如果你喺你屋企見到我個頭，請佢返嚟。", "我今晚會好好睡。如果你在你家看到我的頭，請叫它回來。", "夜"], ["倉庫最高嗰格？我伸個頭去睇吓有冇貨。有，仲有隻老鼠。", "倉庫最高那格？我伸頭去看看有沒有貨。有，還有一隻老鼠。", "p:store"], ["贏咗！我伸高條頸望勝利！", "贏了！我伸長脖子看勝利！", "win"], ["輸咗……我縮返條頸，冷靜吓。", "輸了……我縮回脖子，冷靜一下。", "lose"], ["{N}入村？我已經伸咗個頭去睇。佢好有禮貌，叫咗聲「哇」。", "{N}進村了？我已經伸頭去看了。他很有禮貌，叫了一聲「哇」。", "new"], ["龐總話要「眼光放遠」。我條頸都伸咗出村口。", "龐總說要「眼光放遠」。我脖子都伸出村口了。", "boss"], ["我諗住買個頸枕。", "我想買個頸枕。", "arc:roku:1"], ["頸枕得一個尺寸。我買咗十二個。", "頸枕只有一個尺寸。我買了十二個。", "arc:roku:2"], ["我而家條頸好似一條毛毛蟲。好舒服。", "我現在脖子像一條毛毛蟲。很舒服。", "arc:roku:3"], ["冼小姐話我上班時間個頭唔可以離開座位。我個身喺度，我個頭話：「我都喺度。」", "冼小姐說我上班時頭不能離開座位。我身體在這裡，我的頭說：「我也在這裡。」", "hr"], ["Bryan 喺牆後面講是非。我條頸伸過去，佢即刻改口讚人。", "Bryan 在牆後說閒話。我的脖子伸過去，他馬上改口誇人。", "rival"]], "n30_kuchisake": [["我靚唔靚？", "我漂亮嗎？"], ["我最怕人答「麻麻地」。答「靚」我又唔信。", "我最怕人答「還好」。答「漂亮」我又不信。"], ["我戴口罩戴咗幾十年，疫情嗰陣終於冇人覺得我奇怪。", "我戴口罩戴了幾十年，疫情時終於沒人覺得我奇怪了。"], ["我把較剪係用嚟剪頭髮㗎。真係。大部分時間。", "我的剪刀是用來剪頭髮的。真的。大部分時候。"], ["我笑起上嚟好闊。闊到耳仔。", "我笑起來很燦爛。燦爛到耳朵。"], ["我食飯要除口罩，所以我食飯唔畀人望。", "我吃飯要拿口罩，所以吃飯不讓人看。"], ["有人送咗盒糖畀我。我好感動，佢跑得好快。", "有人送了一盒糖給我。我很感動，他跑得很快。"], ["我問「我靚唔靚」唔係想嚇人，係真係冇自信。", "我問「我漂亮嗎」不是想嚇人，是真的沒自信。"], ["口罩我有一百個，配唔同衫。", "口罩我有一百個，搭配不同衣服。"], ["夜晚出街，我會問路人一個問題。佢哋通常唔答。", "晚上出門，我會問路人一個問題。他們通常不回答。", "夜"], ["包子鋪？我包包好靚。……你覺得呢？", "包子鋪？我包的包子很漂亮。……你覺得呢？", "p:bun"], ["贏咗！……我笑緊，你睇唔到，口罩遮住。好彩。", "贏了！……我在笑，你看不到，口罩遮住了。還好。", "win"], ["輸咗……我靚唔靚？……唔好答，今日唔係時候。", "輸了……我漂亮嗎？……不用回答，今天不是時候。", "lose"], ["{N}入村？我去問佢個問題。", "{N}進村了？我去問他一個問題。", "new"], ["龐總答咗「OK 啦」。我唔知「OK 啦」係靚定唔靚。我諗咗三日。", "龐總答了「OK 啦」。我不知道「OK 啦」是漂亮還是不漂亮。我想了三天。", "boss"], ["我決定去上自信課。", "我決定去上自信課。", "arc:kuchi:1"], ["導師叫我對住鏡講「我好靚」。我講咗，塊鏡裂咗。", "老師叫我對著鏡子說「我很漂亮」。我說了，鏡子裂了。", "arc:kuchi:2"], ["導師話：「有進步，至少你冇問塊鏡。」", "老師說：「有進步，至少你沒問鏡子。」", "arc:kuchi:3"], ["冼小姐話工作時唔可以問同事外貌問題。我改咗問：「我專唔專業？」", "冼小姐說工作時不能問同事外貌問題。我改問：「我專不專業？」", "hr"], ["Bryan 答我「你係全村最靚」。我知佢對每個都咁講。", "Bryan 回答我「你是全村最美」。我知道他對每個人都這樣說。", "rival"]], "n30_yukionna": [["凍唔凍呀？我覺得啱啱好。", "冷不冷？我覺得剛剛好。"], ["我一入倉庫，啲壽包即刻變急凍。保鮮期長咗三個月。", "我一進倉庫，壽包馬上變冷凍。保存期限長了三個月。"], ["我呵一口氣就落雪。所以我唔可以打噴嚏。", "我呵一口氣就下雪。所以我不能打噴嚏。"], ["我最想試嘅嘢：熱湯。我試過，湯結咗冰。", "我最想試的東西：熱湯。我試過，湯結冰了。"], ["馬來西亞好熱，我好辛苦。但係大家都好鍾意企喺我隔籬。", "馬來西亞好熱，我很辛苦。但大家都很喜歡站在我旁邊。"], ["我同人握手，佢要即刻去浸熱水。", "我跟人握手，他要馬上去泡熱水。"], ["我著白色唔係為咗靚，係耐污。雪都係白。", "我穿白色不是為了好看，是耐髒。雪也是白的。"], ["有人叫我做「人肉冷氣」。我唔係人，我係鬼肉冷氣。", "有人叫我「人肉冷氣」。我不是人，我是鬼肉冷氣。"], ["我唔識游水，因為一落水，個池就變溜冰場。", "我不會游泳，因為一下水，泳池就變溜冰場。"], ["夜晚好涼……我意思係，對你哋嚟講好凍。對唔住。", "晚上好涼……我是說，對你們來說很冷。對不起。", "夜"], ["包子鋪？我入去之後，啲包要等兩個鐘先蒸得熱。", "包子鋪？我進去以後，包子要等兩個鐘頭才蒸得熱。", "p:bun"], ["贏咗！我落一場雪慶祝！……你哋去拎件外套先。", "贏了！我下一場雪慶祝！……你們先去拿外套。", "win"], ["輸咗……我冷靜一下。我好容易冷靜。", "輸了……我冷靜一下。我很容易冷靜。", "lose"], ["{N}入村？我歡迎佢……用一口暖暖嘅氣。但係我冇暖嘅氣。", "{N}進村了？我歡迎他……用一口暖暖的氣。但我沒有暖的氣。", "new"], ["龐總話要「冷靜處理」。我好在行。佢條領呔結咗冰。", "龐總說要「冷靜處理」。我很在行。他的領帶結冰了。", "boss"], ["我想學煲湯。", "我想學煲湯。", "arc:yuki:1"], ["孟婆教我。我煲咗三個鐘，個湯變咗雪條。", "孟婆教我。我煲了三個鐘頭，湯變成冰棒。", "arc:yuki:2"], ["孟婆話：「都係湯，凍啲啫。」我好感動。中暑鬼食晒。", "孟婆說：「也是湯，冷了點而已。」我好感動。中暑鬼全吃光了。", "arc:yuki:3"], ["冼小姐要我坐遠冷氣口。我話我就係冷氣口。", "冼小姐要我坐離冷氣口遠一點。我說我就是冷氣口。", "hr"], ["Bryan 企喺我隔籬話好涼。之後佢講是非，我呵咗一口氣，佢塊面凍到講唔到嘢。", "Bryan 站我旁邊說好涼。後來他說閒話，我呵了一口氣，他的臉凍到說不出話。", "rival"]], "n30_hannya": [["點解佢有我冇？！", "為什麼她有我沒有？！"], ["見到人哋有新衫，我個頭就會冒煙。", "看到別人有新衣服，我頭就會冒煙。"], ["我兩隻角係嫉妒生出嚟嘅。每次嫉妒，就長多一厘米。", "我的兩隻角是嫉妒長出來的。每嫉妒一次，就長一公分。"], ["我好努力唔嫉妒人。我嫉妒嗰啲唔使努力都唔嫉妒嘅人。", "我很努力不嫉妒別人。我嫉妒那些不用努力就不嫉妒的人。"], ["我嘅面具好有名，但係人哋淨係記得面具，唔記得我。我嫉妒個面具。", "我的面具很有名，但大家只記得面具，不記得我。我嫉妒面具。"], ["我冷靜落嚟係好溫柔嘅。只係我好少冷靜。", "我冷靜下來是很溫柔的。只是我很少冷靜。"], ["我啲煙係有顏色㗎：綠色係嫉妒，紅色係嬲，紫色係兩樣都有。", "我的煙是有顏色的：綠色是嫉妒，紅色是生氣，紫色是兩樣都有。"], ["人哋話我小器。我只係對比較好敏感。", "人家說我小氣。我只是對比較很敏感。"], ["我唔鍾意朋友圈。全部都係人哋過得好過我。", "我不喜歡看朋友圈。全都是別人過得比我好。"], ["夜晚冇人出新相，我終於可以休息。", "晚上沒人發新照片，我終於可以休息。", "夜"], ["包子鋪？點解小紙啲包摺得靚過我？！……（冒煙）", "包子鋪？為什麼小紙的包子摺得比我漂亮？！……（冒煙）", "p:bun"], ["贏咗！……但係點解佢哋拎 MVP 唔係我？！", "贏了！……但為什麼他們拿 MVP 不是我？！", "win"], ["輸咗。至少對方冇得寸進尺……佢哋有？！", "輸了。至少對方沒得寸進尺……他們有？！", "lose"], ["{N}入村？佢件衫邊度買？！", "{N}進村了？他的衣服哪裡買的？！", "new"], ["龐總讚咗冇面鬼。（冒煙）點解唔讚我？我有面㗎！", "龐總誇了無臉鬼。（冒煙）為什麼不誇我？我有臉的！", "boss"], ["我決定修心養性。", "我決定修身養性。", "arc:hannya:1"], ["我學打坐。隔籬嗰個坐得好過我。（冒煙）", "我學打坐。旁邊那個坐得比我好。（冒煙）", "arc:hannya:2"], ["我改咗學嫉妒自己。今日嘅我嫉妒尋日嘅我，所以進步咗。", "我改成嫉妒自己。今天的我嫉妒昨天的我，所以進步了。", "arc:hannya:3"], ["冼小姐話職場要「正向思維」。我諗咗一陣：點解佢咁正向？！", "冼小姐說職場要「正向思維」。我想了一下：為什麼她這麼正向？！", "hr"], ["Bryan 拎咗個「最佳員工」。我冒咗成晚煙，成條村以為火燭。", "Bryan 拿了「最佳員工」。我冒了一整晚的煙，全村以為失火了。", "rival"]], "n30_gashadokuro": [["餓……好餓……", "餓……好餓……"], ["我一餐要食晒成間包子鋪。所以包子鋪而家有防盜網。", "我一餐要吃光整間包子鋪。所以包子鋪現在有防盜網。"], ["我係由好多副骨頭砌成嘅。有啲骨頭夜晚會傾偈。", "我是用很多副骨頭拼成的。有些骨頭晚上會聊天。"], ["我好大，但係我好怕醜。", "我很大，但我很害羞。"], ["我坐低嘅時候要預先通知，免得壓親人。", "我坐下前要先通知，免得壓到人。"], ["我啲骨頭好多，所以我嘅身份證要用一本簿。", "我的骨頭很多，所以我的身分證要用一本冊子。"], ["有人話我係「巨人」。我話：我淨係骨架大。", "有人說我是「巨人」。我說：我只是