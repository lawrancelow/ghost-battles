# 地勢：0 河 → 6 山頂。水位高過地勢就浸
static func height(cx: int, cy: int) -> float:
	var t = float(cy) / ROWS
	var h = 6.2 - t * 5.4                          # 北高南低
	var rv = abs(cx - (6.0 + cy * 0.12)) # 河道（西南斜落）
	if cy > 30: h -= maxf(0.0, 2.6 - rv * 0.55)
	if cx > 25 and cy > 36: h -= 0.9               # 東南稻田
	var road = abs(cx - 18) < 1.6 and cy < 40      # 中路（路基高少少）
	if road: h += 0.7
	for p in [GRANNY_HOUSE, GUARD_HUT, Vector2(20, 30), Vector2(27, 31), Vector2(15, 28)]:   # 高腳屋一帶墊高
		if Vector2(cx, cy).distance_to(p) < 2.2: h += 0.6
	if Vector2(cx, cy).distance_to(SHOP) < 4.0: h = maxf(h, 6.0)
	h += (_n(cx, cy) - 0.5) * 0.7
	return h

static func _n(x: int, y: int) -> float:
	var h = (x * 374761393 + y * 668265263) & 0x7fffffff
	h = ((h ^ (h >> 13)) * 1274126177) & 0x7fffffff
	return float(h % 1000) / 1000.0

# 道具擺位：[圖, 格x, 格y, 大小, 擋路半徑]
static func props() -> Array:
	var a = []
	for p in [[GRANNY_HOUSE, "pr_stilt"], [Vector2(20, 30), "pr_stilt"], [Vector2(27, 31), "pr_stilt"], [Vector2(15, 28), "pr_hut"], [Vector2(11, 24), "pr_stilt"], [Vector2(26, 20), "pr_hut"]]:
		a.append([p[1], p[0].x, p[0].y - 0.6, 150.0, 46.0])
	a.append(["pr_hut", GUARD_HUT.x, GUARD_HUT.y - 0.5, 110.0, 34.0])
	a.append(["pr_well", 22, 23, 60.0, 22.0])
	for i in 46:
		var x = 1 + int(_n(i, 7) * 34); var y = 9 + int(_n(i, 11) * 45)
		var c = Vector2(x, y)
		var bad = c.distance_to(SHOP) < 5 or abs(x - 18) < 2 and y < 40 or c.distance_to(GATE) < 3 or c.distance_to(BRIDGE) < 3
		for r in RIFTS: if c.distance_to(r) < 3: bad = true
		if bad: continue
		var k = ["pr_palm", "pr_banana", "pr_bush", "pr_palm", "pr_bush2", "pr_rocks", "pr_fern", "pr_deadtree"][i % 8]
		var sz = {"pr_palm": 150.0, "pr_banana": 110.0, "pr_deadtree": 120.0}.get(k, 60.0)
		a.append([k, x + _n(i, 3) * 0.6, y + _n(i, 5) * 0.6, sz, 16.0 if sz > 100 else 0.0])
	for p in [Vector2(18, 12), Vector2(18, 20), Vector2(18, 28), Vector2(16, 36), Vector2(21, 40)]:
		a.append(["pr_lamp", p.x + 1.2, p.y, 90.0, 8.0])
	return a

# 可搜刮點（每晚重置）：[圖, 格x, 格y, 掉落]
static func caches() -> Array:
	var a = []
	var spots = [[23, 35, "pr_cabinet"], [21, 31, "pr_cooler"], [28, 32, "pr_boxes"], [16, 29, "pr_cart"], [12, 25, "pr_boxes"],
		[26, 21, "pr_scooter"], [24, 27, "pr_cabinet"], [13, 39, "pr_boxes"], [8, 41, "pr_cart"], [30, 44, "pr_boxes"],
		[20, 45, "pr_cooler"], [33, 47, "pr_cart"], [6, 33, "pr_boxes"], [29, 25, "pr_cooler"], [10, 30, "pr_scooter"], [19, 50, "pr_boxes"]]
	var i = 0
	for s in spots:
		var loot = {}
		match i % 4:
			0: loot = {"wood": 3.0, "cloth": 1.0}
			1: loot = {"iron": 2.0, "bottle": 1.0}
			2: loot = {"bat": 1.0, "wood": 1.0}
			3: loot = {"cloth": 2.0, "bottle": 2.0}
		if s[1] > 40: for k in loot.keys(): loot[k] = loot[k] + 1.0    # 低窪多啲（但危險）
		a.append({"k": s[2], "x": s[0], "y": s[1], "loot": loot})
		i += 1
	return a

